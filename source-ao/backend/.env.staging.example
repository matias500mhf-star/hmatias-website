# Source AO staging environment template
# Copy values into the deployment provider's secret/environment manager.
# Never commit real secret values.

SOURCE_AO_ENV=staging
PUBLIC_ORIGIN=https://staging.example.invalid
SOURCE_AO_API_BASE=https://source-ao-api-staging.example.workers.dev
CONTACT_RETENTION_DAYS=30

# Secret: strong random bearer token for HMATIAS internal routes
ADMIN_API_TOKEN=

# Secret: strong random HMAC secret for supplier confirmation links
CONFIRMATION_SECRET=

# Secret: strong random secret used to derive the AES-GCM key for requester contacts
PII_ENCRYPTION_KEY=

# Secret: strong random HMAC secret used to pseudonymize client addresses for rate limiting
RATE_LIMIT_SECRET=

# Deployment metadata / provider values
SOURCE_AO_STAGING_D1_ID=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

SOURCE_AO_RELEASE=source-ao-v1
LOG_LEVEL=info
