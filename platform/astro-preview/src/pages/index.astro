---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import ServiceSection from "../components/ServiceSection.astro";
import ProjectGallery from "../components/ProjectGallery.astro";
import ContactSection from "../components/ContactSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
import heroPhoto from "../../../../images/catalogue/instalacoes-embutidas-construcao.webp";
import { company } from "../data/site";
---
<BaseLayout
  title="HMATIAS — Construção, Facilities, Supply e Business Services | Angola"
  description="Construção, manutenção, fornecimento e apoio a projectos para empresas e clientes em Angola."
>
  <div class="preview-bar">
    <span><i aria-hidden="true"></i> PROTÓTIPO TECNOLÓGICO ASTRO</span>
    <span>Homepage HMATIAS · Ambiente isolado de avaliacção</span>
  </div>
  <SiteHeader />
  <main>
    <section class="hero" id="inicio">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-line"></span> Construção · Facilities · Supply · Business Services</p>
        <h1>Capacidade para<br /><em>fazer acontecer.</em></h1>
        <p class="hero-lead">Construção, facilities, fornecimento e apoio administrativo e empresarial para empresas e projectos em Angola.</p>
        <div class="hero-actions">
          <a class="button button-light" href="#servicos">Conhecer serviços <span aria-hidden="true">↓</span></a>
          <a class="text-link text-link-light" href={company.whatsappUri} target="_blank" rel="noopener noreferrer">Contactar a equipa <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-meta">
          <span>{company.name}</span>
          <span>Viana, Luanda · Angola</span>
        </div>
      </div>
      <div class="hero-image-wrap">
        <Image
          src={heroPhoto}
          alt="Interior de obra HMATIAS com alvenaria e instalacções técnicas embutidas"
          widths={[640, 960, 1280]}
          sizes="(max-width: 900px) 100vw, 50vw"
          format="webp"
          quality={84}
          loading="eager"
          fetchpriority="high"
        />
        <div class="image-index"><span>01</span><span>OBRA REAL HMATIAS</span></div>
      </div>
      <div class="hero-side-note">EXECUÇÃO · FORNECIMENTO · OPERAÇÃO</div>
    </section>

    <section class="intro section-pad" id="empresa">
      <div class="section-kicker">01 / QUEM SOMOS</div>
      <div class="intro-content">
        <h2>Uma empresa de serviços.<br /><em>Várias frentes de execução.</em></h2>
        <div class="intro-text">
          <p>A HMATIAS apoia empresas, instituições e clientes particulares com soluções de construção e remodelacção, facilities e manutenção, procurement e fornecimento, e apoio administrativo e empresarial.</p>
          <p>Da necessidade à execução: escopo claro, comunicacção directa e acompanhamento do trabalho.</p>
          <a class="underlined-link" href={company.credibilityUrl}>Conhecer a HMATIAS <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <ServiceSection />
    <ProjectGallery />

    <section class="statement">
      <div class="statement-mark" aria-hidden="true">“</div>
      <div class="statement-content">
        <p>O próximo projecto começa com uma conversa clara sobre o que precisa de ser feito.</p>
        <a class="button button-dark" href="#contacto">Apresentar um pedido <span aria-hidden="true">↗</span></a>
      </div>
      <span class="statement-label">HMATIAS · AO</span>
    </section>

    <ContactSection />
  </main>
  <SiteFooter />
  <div class="preview-disclaimer">Protótipo tecnológico independente. Não substitui nem modifica o website oficial da HMATIAS.</div>
</BaseLayout>