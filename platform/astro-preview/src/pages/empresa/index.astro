---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import aboutPhoto from "../../../../../images/catalogue/pavilhoes-rurais-concluidos.webp";
import { company } from "../../data/site";
---
<BaseLayout
  title="Sobre a HMATIAS | Quem Somos"
  description="Conheça a HMATIAS – Prestação de Serviços SU, LDA, empresa angolana de construção, facilities, procurement e serviços empresariais, sediada em Viana, Luanda."
>
  <div class="preview-bar"><span><i aria-hidden="true"></i> SOBRE A HMATIAS</span><span>EMPRESA ANGOLANA · LUANDA</span></div>
  <SiteHeader />
  <main class="about-page">
    <section class="about-hero">
      <div class="about-copy">
        <p class="eyebrow"><span class="eyebrow-line"></span> QUEM SOMOS</p>
        <h1>Empresa angolana.<br /><em>Serviços para empresas e projetos.</em></h1>
        <p class="about-lead">A HMATIAS – Prestação de Serviços SU, LDA é uma empresa angolana sediada em Viana, Luanda, com atividade em construção, facilities, supply e serviços empresariais.</p>
        <div class="about-actions">
          <a class="button button-light" href="/#servicos">Conhecer os serviços <span aria-hidden="true">↗</span></a>
          <a class="text-link text-link-light" href={company.credibilityUrl}>Informação institucional <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <figure class="about-visual">
        <Image
          src={aboutPhoto}
          alt="Pavilhões rurais concluídos, com cobertura metálica e áreas laterais ventiladas"
          widths={[640, 960, 1280]}
          sizes="(max-width: 900px) 100vw, 44vw"
          format="webp"
          quality={84}
        />
        <figcaption><span>HMATIAS</span><span>TRABALHO NO TERRENO</span></figcaption>
      </figure>
    </section>

    <section class="about-services section-pad" id="servicos">
      <div class="about-section-head">
        <div><p class="section-kicker">O QUE FAZEMOS</p><h2>Áreas de serviço.</h2></div>
      </div>
      <div class="about-service-grid">
        <a href={company.constructionUrl}><span>01</span><h3>Construção e remodelação</h3><p>Obras, reabilitação, pavimentação, estruturas e adaptação de espaços.</p><b>Ver serviço ↗</b></a>
        <a href={company.facilitiesUrl}><span>02</span><h3>Facilities e manutenção</h3><p>Manutenção de instalações, limpeza e apoio operacional.</p><b>Ver serviço ↗</b></a>
        <a href={company.supplyUrl}><span>03</span><h3>Supply e procurement</h3><p>Pesquisa, aquisição e coordenação de fornecimentos sob consulta.</p><b>Ver serviço ↗</b></a>
        <a href={company.businessServicesUrl}><span>04</span><h3>Business Services</h3><p>Apoio administrativo, documental e empresarial.</p><b>Ver serviço ↗</b></a>
      </div>
    </section>

    <section class="about-purpose section-pad" id="identidade">
      <div class="about-section-head">
        <div><p class="section-kicker">A ORIENTAÇÃO DA EMPRESA</p><h2>O que orienta<br /><em>o nosso trabalho.</em></h2></div>
      </div>
      <div class="purpose-grid">
        <article class="purpose-card purpose-mission"><span>MISSÃO</span><h3>Transformar necessidades empresariais em serviços e fornecimentos executáveis.</h3><p>Definimos o âmbito, clarificamos responsabilidades e acompanhamos o trabalho acordado, com comunicação responsável.</p></article>
        <article class="purpose-card purpose-vision"><span>VISÃO</span><h3>Consolidar a HMATIAS como uma empresa angolana reconhecida pela execução rigorosa.</h3><p>Queremos crescer com base em competência técnica, responsabilidade contratual e relações comerciais consistentes.</p></article>
      </div>
      <div class="values-heading"><p class="section-kicker">PRINCÍPIOS NA PRÁTICA</p><h3>Valores que orientam a atuação.</h3></div>
      <div class="values-grid">
        <article><span>01</span><h4>Rigor técnico</h4><p>Especificações e condições adequadas ao trabalho solicitado.</p></article>
        <article><span>02</span><h4>Responsabilidade</h4><p>Compromissos e entregáveis definidos antes da execução.</p></article>
        <article><span>03</span><h4>Transparência</h4><p>Informação clara sobre âmbito, preço, prazo e limitações.</p></article>
        <article><span>04</span><h4>Confidencialidade</h4><p>Tratamento responsável da informação recebida dos clientes.</p></article>
        <article><span>05</span><h4>Compromisso</h4><p>Acompanhamento do serviço nos termos acordados.</p></article>
      </div>
    </section>

    <section class="ceo-message section-pad" aria-labelledby="leadership-title">
      <div class="ceo-message-label"><p class="section-kicker">DIREÇÃO HMATIAS</p><span class="ceo-mark" aria-hidden="true">“</span></div>
      <div class="ceo-message-content">
        <h2 id="leadership-title">Uma empresa orientada<br /><em>para executar.</em></h2>
        <blockquote>Na HMATIAS, procuramos compreender primeiro a necessidade, definir com clareza o trabalho a realizar e cumprir o que foi acordado. É assim que queremos construir relações duradouras com clientes, parceiros e fornecedores.</blockquote>
        <div class="ceo-signature"><span>POSICIONAMENTO INSTITUCIONAL</span><strong>Direção HMATIAS</strong><small>HMATIAS – Prestação de Serviços SU, LDA</small></div>
      </div>
    </section>

  </main>
  <SiteFooter />
  <div class="preview-disclaimer">Protótipo tecnológico independente. Não substitui nem modifica o website oficial da HMATIAS.</div>
</BaseLayout>
<style>
.about-hero { padding:clamp(62px,8vw,108px) var(--hm-gutter); display:grid; grid-template-columns:minmax(0,1.05fr) minmax(320px,.95fr); align-items:center; gap:clamp(38px,7vw,100px); color:#fff; background:var(--hm-navy); }
.about-copy { max-width:700px; }
.about-copy h1 { max-width:690px; margin:0; font-size:clamp(43px,5.8vw,76px); line-height:1.02; font-weight:520; letter-spacing:-.065em; }
.about-copy h1 em,.about-section-head h2 em,.ceo-message h2 em { color:#b9d8ed; font-family:var(--hm-serif); font-weight:400; }
.about-lead { max-width:600px; margin:25px 0 0; color:#f2f7fc; font-size:14px; line-height:1.85; }
.about-support { max-width:570px; margin:14px 0 0; color:#c4d8e9; font-size:12px; line-height:1.8; }
.about-actions { display:flex; flex-wrap:wrap; align-items:center; gap:22px; margin-top:32px; }
.about-visual { position:relative; margin:0; padding:0 16px 16px 0; }
.about-visual:after { position:absolute; z-index:0; content:""; inset:16px 0 0 16px; border:1px solid #83c6f277; pointer-events:none; }
.about-visual img { position:relative; z-index:1; width:100%; aspect-ratio:1.12; object-fit:cover; background:#0b477c; }
.about-visual figcaption { position:relative; z-index:2; display:flex; justify-content:space-between; gap:12px; padding:15px 17px; color:var(--hm-navy); background:var(--hm-paper); font-size:8px; font-weight:700; letter-spacing:.13em; }
.about-section-head { display:flex; justify-content:space-between; align-items:end; gap:45px; }
.about-section-head h2,.ceo-message h2 { margin:22px 0 0; font-size:clamp(36px,4.7vw,62px); line-height:1.08; font-weight:520; letter-spacing:-.06em; }
.about-section-head h2 em { color:var(--hm-blue); }
.about-section-head > p { max-width:330px; margin:0 0 6px; color:var(--hm-muted); font-size:12px; line-height:1.8; }
.about-services { background:var(--hm-light); }
.about-service-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14px; margin-top:48px; }
.about-service-grid a { min-height:220px; padding:23px 20px; display:flex; flex-direction:column; align-items:flex-start; background:var(--hm-paper); border:1px solid var(--hm-line); transition:transform .2s,border-color .2s; }
.about-service-grid a:hover { transform:translateY(-3px); border-color:#89bde7; }
.about-service-grid a > span { color:var(--hm-blue); font-family:var(--hm-serif); font-size:19px; }
.about-service-grid h3 { margin:27px 0 10px; font-size:15px; line-height:1.35; }
.about-service-grid p { margin:0 0 18px; color:var(--hm-muted); font-size:11px; line-height:1.75; }
.about-service-grid b { margin-top:auto; color:var(--hm-blue); font-size:10px; }
.about-purpose { background:var(--hm-paper); }
.purpose-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; margin-top:45px; }
.purpose-card { min-height:285px; padding:clamp(25px,3.2vw,42px); border:1px solid var(--hm-line); background:var(--hm-light); }
.purpose-card > span,.values-grid article > span { color:var(--hm-blue); font-size:9px; font-weight:750; letter-spacing:.15em; }
.purpose-card h3 { max-width:440px; margin:35px 0 15px; font-family:var(--hm-serif); font-size:clamp(24px,2.7vw,34px); font-weight:400; line-height:1.25; letter-spacing:-.025em; }
.purpose-card p { max-width:540px; margin:0; color:var(--hm-muted); font-size:12px; line-height:1.9; }
.purpose-vision { color:#fff; background:var(--hm-navy); border-color:var(--hm-navy); }
.purpose-vision > span { color:#9ecff2; }
.purpose-vision h3 { color:#fff; }
.purpose-vision p { color:#d2e1ef; }
.values-heading { display:flex; align-items:end; justify-content:space-between; gap:24px; margin:58px 0 20px; padding-bottom:18px; border-bottom:1px solid var(--hm-line); }
.values-heading .section-kicker { margin:0; }
.values-heading h3 { margin:0; font-size:15px; font-weight:600; }
.values-grid { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:12px; }
.values-grid article { min-height:185px; padding:19px 16px; border:1px solid var(--hm-line); background:#fff; }
.values-grid article > span { font-family:var(--hm-serif); font-size:17px; letter-spacing:0; }
.values-grid h4 { margin:22px 0 9px; font-size:13px; line-height:1.35; }
.values-grid p { margin:0; color:var(--hm-muted); font-size:10px; line-height:1.75; }
.ceo-message { display:grid; grid-template-columns:.65fr 1.35fr; gap:50px; background:var(--hm-paper); }
.ceo-message-label { display:flex; flex-direction:column; justify-content:space-between; }
.ceo-mark { color:var(--hm-sky-soft); font-family:var(--hm-serif); font-size:clamp(100px,15vw,190px); line-height:.7; }
.ceo-message-content { max-width:780px; }
.ceo-message h2 em { color:var(--hm-blue); }
.ceo-message blockquote { margin:30px 0 0; color:var(--hm-ink); font-family:var(--hm-serif); font-size:clamp(20px,2.2vw,27px); line-height:1.55; letter-spacing:-.02em; }
.ceo-signature { display:flex; flex-direction:column; align-items:flex-start; gap:4px; margin-top:38px; padding-top:20px; border-top:1px solid var(--hm-line); }
.ceo-signature span { color:var(--hm-muted); font-size:9px; letter-spacing:.15em; text-transform:uppercase; }
.ceo-signature strong { color:var(--hm-navy); font-family:var(--hm-serif); font-size:29px; font-style:italic; font-weight:500; letter-spacing:-.04em; }
.ceo-signature small { color:var(--hm-muted); font-size:9px; }
@media (max-width:1000px) {
  .values-grid { grid-template-columns:repeat(3,minmax(0,1fr)); }

  .about-hero { grid-template-columns:1fr  .82fr; gap:35px; }
  .about-service-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
}
@media (max-width:700px) {
  .purpose-grid { grid-template-columns:1fr; }
  .purpose-card { min-height:0; }
  .values-heading { display:block; }
  .values-heading h3 { margin-top:14px; }
  .values-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }

  .about-hero { grid-template-columns:1fr; padding-top:58px; }
  .about-visual { max-width:560px; margin:10px 0 0; }
  .about-section-head { display:block; }
  .about-section-head > p { margin-top:18px; }
  .about-service-grid { grid-template-columns:1fr; margin-top:30px; }
  .about-service-grid a { min-height:0; }
  .about-service-grid h3 { margin-top:17px; }
  .ceo-message { grid-template-columns:1fr; gap:12px; }
  .ceo-mark { display:none; }
}
@media (prefers-reduced-motion:reduce) {
  .about-service-grid a { transition:none; }
}
</style>
