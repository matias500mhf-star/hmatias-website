---
import { Picture } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { company } from "../../data/site";
import heroPhoto from "../../../../../images/catalogue/chapas-cobertura-fornecimento.webp";
import metalProfiles from "../../../../../images/catalogue/perfis-metalicos-estrutura.webp";
import logisticsPhoto from "../../../../../images/catalogue/logistica-estrutura-metalica.webp";

const whatsappSupply = company.whatsappUri + "?text=" + encodeURIComponent(
  "Olá, HMATIAS. Pretendo solicitar uma cotação de fornecimento. Seguem a especificação, quantidade, destino e prazo pretendido:"
);
---
<BaseLayout
  title="HMATIAS Supply | Procurement e Fornecimento Empresarial"
  description="Fornecimento empresarial e procurement em Angola. Consumíveis diamantados, fardamento, EPI, materiais e equipamentos mediante consulta e confirmação."
>
  <div class="preview-bar"><span><i aria-hidden="true"></i> HMATIAS SUPPLY</span><span>PROCUREMENT · SOURCING · FORNECIMENTO</span></div>
  <SiteHeader />
  <main class="supply-page">
    <section class="construction-hero supply-hero" id="inicio" aria-labelledby="pages-supply-index-section-1-heading">
      <div class="construction-hero-copy">
        <nav class="construction-breadcrumb" aria-label="Navegação estrutural"><a href="/">Início</a><span aria-hidden="true">/</span><span>Supply</span></nav>
        <p class="eyebrow"><span class="eyebrow-line"></span> HMATIAS SUPPLY · PROCUREMENT</p>
        <h1 id="pages-supply-index-section-1-heading">Fornecimento<br /><em>com critério.</em></h1>
        <p class="hero-lead">Identificamos soluções de fornecimento a partir da especificação do cliente, consultamos parceiros e verificamos as condições comerciais antes de apresentar uma proposta.</p>
        <div class="hero-actions"><a class="button button-light" href="#pedido">Solicitar cotação <span aria-hidden="true">↓</span></a><a class="text-link text-link-light" href={company.sourceAoUrl}>SOURCE AO <span aria-hidden="true">↗</span></a></div>
        <div class="hero-meta"><span>Materiais de construção · Consumíveis · EPI e fardamento · Equipamentos</span><span>Angola · consultas regionais quando aplicável</span></div>
      </div>
      <figure class="construction-hero-image supply-hero-image">
        <Picture src={heroPhoto} alt="Chapas perfiladas documentadas para consultas de fornecimento" widths={[640,960,1280]} sizes="(max-width:900px) 100vw,48vw" formats={["avif", "webp"]} fallbackFormat="jpg" quality={84} loading="eager" fetchpriority="high" decoding="async" />
        <figcaption><span>01</span> REGISTO DE MATERIAL · HMATIAS</figcaption>
      </figure>
    </section>

    <section class="construction-intro section-pad supply-intro" aria-labelledby="pages-supply-index-section-2-heading">
      <div class="section-kicker">01 / MODELO DE FORNECIMENTO</div>
      <div class="construction-intro-content">
        <h2 id="pages-supply-index-section-2-heading">Da especificação<br /><em>à proposta.</em></h2>
        <div class="construction-intro-copy"><p>A HMATIAS não mantém stock próprio. Presta serviços de fornecimento industrial e procurement; cada pedido é analisado por referência, quantidade, aplicação, destino e prazo. A disponibilidade, o preço, a documentação e a logística são confirmados antes da proposta.</p></div>
      </div>
    </section>


    <section class="supply-categories section-pad" id="categorias" aria-labelledby="pages-supply-index-section-3-heading">
      <div class="section-heading">
        <div><div class="section-kicker">02 / CATEGORIAS DE FORNECIMENTO</div><h2 id="pages-supply-index-section-3-heading">O pedido começa<br /><em>pela especificação.</em></h2></div>
        <p>Consultamos o mercado de acordo com a aplicação, os requisitos técnicos, a quantidade e o destino indicado pelo cliente.</p>
      </div>
      <div class="supply-category-grid">
        <article class="supply-category-card"><span>01</span><h3>Materiais de construção</h3><p>Perfis, chapas, elementos metálicos e outros materiais identificados por referência, dimensão e aplicação.</p></article>
        <article class="supply-category-card"><span>02</span><h3>Consumíveis industriais</h3><p>Discos diamantados, coroas de perfuração e consumíveis técnicos sujeitos a consulta por marca e especificação.</p></article>
        <article class="supply-category-card"><span>03</span><h3>EPI e fardamento</h3><p>Equipamentos de protecção individual e vestuário profissional, com verificação de tamanhos, normas e documentação exigida.</p></article>
        <article class="supply-category-card"><span>04</span><h3>Equipamentos e ferramentas</h3><p>Equipamentos e ferramentas avaliados conforme requisitos técnicos, disponibilidade, condições comerciais e logística.</p></article>
      </div>
      <div class="specialist-inline-links">
        <a href="/fornecimento-de-epi-e-fardamento/">Página especializada: EPI e fardamento ↗</a>
      </div>
    </section>
    <section class="supply-partners section-pad" id="parceiros" aria-labelledby="pages-supply-index-section-4-heading">
      <div class="section-heading">
        <div><div class="section-kicker">03 / CATEGORIAS E FONTES DE FORNECIMENTO</div><h2 id="pages-supply-index-section-4-heading">Uma oferta<br /><em>seleccionada.</em></h2></div>
        <p>Apresentamos categorias de fornecimento e fontes de consulta. A disponibilidade e as condições de cada artigo são verificadas pedido a pedido.</p>
      </div>
      <div class="supply-partner-list">
        <article class="supply-partner">
          <div class="supply-partner-index">01</div>
          <div class="supply-partner-main">
            <p class="supply-partner-type">CONSUMÍVEIS DIAMANTADOS</p>
            <h3>SYNVOR Industrial</h3>
            <p>Fonte de consulta para soluções Carbodiam e SAMEDIA, incluindo discos diamantados, coroas de perfuração e sistemas de carotagem. As referências e condições são confirmadas para cada pedido.</p>
            <div class="supply-tags"><span>Carbodiam</span><span>SAMEDIA</span><span>Discos</span><span>Coroas</span></div>
          </div>
          <div class="supply-partner-action"><a href="#pedido">Solicitar catálogo e cotação <span aria-hidden="true">↗</span></a></div>
        </article>
        <article class="supply-partner">
          <div class="supply-partner-index">02</div>
          <div class="supply-partner-main">
            <p class="supply-partner-type">FARDAMENTO E PROTECÇÃO INDIVIDUAL</p>
            <h3>Evolution Safety Namibia</h3>
            <p>Fonte de consulta para fardamento profissional e equipamentos de protecção individual, mediante requisitos técnicos, tamanhos e quantidades indicados pelo cliente.</p>
            <div class="supply-tags"><span>Fardamento</span><span>EPI</span><span>Consulta sob especificação</span></div>
          </div>
          <div class="supply-partner-action"><a href="#pedido">Consultar fornecimento <span aria-hidden="true">↗</span></a></div>
        </article>
      </div>
    </section>

    <section class="supply-evidence section-pad" id="materiais" aria-labelledby="pages-supply-index-section-5-heading">
      <div class="portfolio-top">
        <div><div class="section-kicker">04 / REGISTOS DE FORNECIMENTO</div><h2 id="pages-supply-index-section-5-heading">Materiais e logística<br /><em>em contexto.</em></h2></div>
        <p>Registos visuais existentes da actividade HMATIAS. Não representam confirmação de stock ou disponibilidade actual.</p>
      </div>
      <div class="supply-evidence-grid">
        <figure class="supply-evidence-photo"><Picture src={metalProfiles} alt="Perfis metálicos documentados para aplicações de construção" widths={[640,960]} sizes="(max-width:700px) 100vw,50vw" formats={["avif", "webp"]} fallbackFormat="jpg" quality={82} decoding="async" loading="lazy" /><figcaption>Perfis metálicos · materiais para construção</figcaption></figure>
        <figure class="supply-evidence-photo"><Picture src={logisticsPhoto} alt="Mobilização logística de elementos metálicos" widths={[640,960]} sizes="(max-width:700px) 100vw,50vw" formats={["avif", "webp"]} fallbackFormat="jpg" quality={82} decoding="async" loading="lazy" /><figcaption>Logística · mobilização de materiais</figcaption></figure>
      </div>
    </section>

    <section class="construction-request section-pad supply-request" id="pedido" aria-labelledby="pages-supply-index-section-6-heading">
      <div class="construction-request-copy">
        <p class="section-kicker">05 / PEDIDO DE FORNECIMENTO</p>
        <h2 id="pages-supply-index-section-6-heading">Indique o que<br /><em>precisa.</em></h2>
        <p>Envie a referência ou descrição técnica, quantidade, local de entrega e prazo pretendido. A HMATIAS analisará o pedido e confirmará as condições antes de apresentar uma proposta.</p>
        <div class="construction-request-actions"><a class="button button-light" href={company.sourceAoRfqUrl + "?from=supply"}>Registar pedido de cotação <span aria-hidden="true">↗</span></a><a class="construction-email-link" href={whatsappSupply} target="_blank" rel="noopener noreferrer">Enviar pelo WhatsApp <span aria-hidden="true">↗</span></a></div>
      </div>
      <aside class="construction-request-guide"><h3>Informação necessária</h3><ul><li>Referência, marca ou descrição do artigo</li><li>Especificação técnica e aplicação</li><li>Quantidade e unidade</li><li>Destino e prazo pretendido</li><li>Normas ou documentação exigida</li></ul><p>O pedido inicia uma consulta. Não constitui confirmação de stock, preço ou prazo.</p></aside>
    </section>
  </main>
  <SiteFooter />
  <div class="preview-disclaimer">Protótipo tecnológico independente. Não substitui nem modifica o website oficial da HMATIAS.</div>
</BaseLayout>
<style>
.supply-hero-image { aspect-ratio:auto; }
.supply-hero-image img { height:auto; background:transparent; }
.supply-categories { background:var(--hm-paper); }
.supply-category-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; margin-top:42px; }
.supply-category-card { min-height:220px; padding:22px 20px; border:1px solid var(--hm-line); background:var(--hm-paper); }
.supply-category-card > span { color:var(--hm-blue); font-family:var(--hm-serif); font-size:17px; }
.supply-category-card h3 { margin:28px 0 12px; font-size:16px; line-height:1.35; font-weight:650; letter-spacing:-.025em; }
.supply-category-card p { margin:0; color:var(--hm-muted); font-size:11px; line-height:1.8; }
.supply-partners { background:var(--hm-light); }
.supply-partner-list { margin-top:48px; border-top:1px solid var(--hm-line); }
.supply-partner { display:grid; grid-template-columns:54px minmax(0,1fr) minmax(190px,.42fr); gap:25px; align-items:start; padding:30px 0; border-bottom:1px solid var(--hm-line); }
.supply-partner-index { color:#005aa8; font-family:var(--hm-serif); font-size:19px; }
.supply-partner-type { margin:0 0 10px; color:#005aa8; font-size:10px; font-weight:700; letter-spacing:.13em; }
.supply-partner-main h3 { margin:0 0 10px; color:var(--hm-ink); font-size:clamp(20px,2.4vw,27px); font-weight:560; letter-spacing:-.04em; }
.supply-partner-main > p:not(.supply-partner-type) { max-width:650px; margin:0; color:var(--hm-muted); font-size:14px; line-height:1.75; }
.supply-tags { display:flex; flex-wrap:wrap; gap:7px; margin-top:17px; }
.supply-tags span { padding:6px 9px; color:var(--hm-muted); border:1px solid var(--hm-line); font-size:10px; }
.supply-partner-action { padding-top:29px; }
.supply-partner-action a { color:var(--hm-ink); font-size:12px; font-weight:650; text-decoration:underline; text-decoration-color:#9bb7ce; text-underline-offset:5px; }
.supply-partner-action a span { padding-left:7px; color:#005aa8; }
.supply-evidence { background:var(--hm-paper); }
.supply-evidence-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:25px; margin-top:40px; }
.supply-evidence-photo { min-width:0; margin:0; }
.supply-evidence-photo img { display:block; width:100%; height:auto; object-fit:contain; }
.supply-evidence-photo figcaption { padding-top:12px; color:var(--hm-muted); font-size:11px; }
.supply-request .construction-request-guide a { color:var(--hm-ink); }
@media(max-width:900px) { .supply-category-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
@media(max-width:800px) {
 .supply-partner { grid-template-columns:36px minmax(0,1fr); gap:15px; }
 .supply-partner-action { grid-column:2; padding-top:0; }
}
@media(max-width:650px) {
 .supply-partner-list { margin-top:34px; }
 .supply-partner { padding:24px 0; }
 .supply-category-grid { grid-template-columns:1fr; }
 .supply-category-card { min-height:0; }
 .supply-category-card h3 { margin-top:17px; }
 .supply-evidence-grid { grid-template-columns:1fr; gap:28px; }
 .supply-partner-main > p:not(.supply-partner-type) { font-size:14px; }
}
.specialist-inline-links{display:flex;flex-wrap:wrap;gap:12px 22px;margin-top:22px;padding:18px 20px;background:var(--hm-sky-soft);border-left:3px solid var(--hm-blue)}.specialist-inline-links a{color:var(--hm-blue);font-size:11px;font-weight:700;text-decoration:underline;text-underline-offset:3px}
</style>