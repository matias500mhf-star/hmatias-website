---
import { Image, Picture } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import logo from "../../../../../logo-hmatias.png";
import coverPhoto from "../../../../../images/catalogue/pavilhoes-rurais-concluidos.webp";
import { company } from "../../../data/site";
import { projects } from "../../../data/projects";
---

<BaseLayout title="Institutional Dossier | HMATIAS — Construction, Facilities and Supply" description="Institutional dossier of HMATIAS: company identification, service areas, documented work records, operating method and official contacts in Luanda, Angola." lang="en">
  <div class="preview-bar"><span><i aria-hidden="true"></i> INSTITUTIONAL DOSSIER</span><span>LUANDA · ANGOLA · 2026 EDITION</span></div>
  <SiteHeader />
  <main class="dossier-page">
    <section class="dossier-cover dossier-sheet" aria-labelledby="dossier-cover-heading">
      <figure class="cover-image">
        <Picture src={coverPhoto} alt="Pavilhões rurais concluídos, com cobertura metálica e laterais ventiladas" widths={[720, 1080, 1440]} sizes="100vw" formats={["avif", "webp"]} fallbackFormat="jpg" quality={84} decoding="async" loading="eager" />
      </figure>
      <div class="cover-top">
        <Image src={logo} alt="HMATIAS — Prestação de Serviços" widths={[128, 192]} sizes="120px" format="webp" quality={86} />
        <span>INSTITUTIONAL DOCUMENT<br />2026 EDITION</span>
      </div>
      <div class="cover-copy">
        <p class="section-kicker">CONSTRUCTION · INFRASTRUCTURE · FACILITIES · SUPPLY</p>
        <h1 id="dossier-cover-heading">Solutions to build,<br /><em>operate and evolve.</em></h1>
        <p>Presentation of HMATIAS – Prestação de Serviços, (SU), Lda., an Angolan company operating in construction, remodelling, facilities, business supply, procurement and business support.</p>
      </div>
      <div class="cover-bottom"><span>VIANA · LUANDA · ANGOLA</span><span>TAX ID {company.taxNumber}</span><span>comercialhmatiasps.com</span></div>
      <div class="cover-action no-print">
        <button type="button" class="print-button" data-print-dossier>Print / save as PDF <span aria-hidden="true">↗</span></button>
        <a href="/en/credibility/">Company information <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="dossier-sheet" aria-labelledby="dossier-profile-heading">
      <div class="sheet-head"><p class="section-kicker">01 / COMPANY PROFILE</p><span class="sheet-number">01</span></div>
      <div class="profile-grid">
        <div>
          <h2 id="dossier-profile-heading">A structure<br /><em>focused on execution.</em></h2>
          <p class="lead">HMATIAS organises responses to business and project requirements by coordinating scope definition, resources, execution, procurement and delivery follow-up according to the conditions of each operation.</p>
          <p>The company was incorporated in 2023 and is based in Viana, Luanda. Its activities combine project execution, facilities care, business supply and operational support.</p>
          <p class="note">The year of incorporation identifies the company's registration; it does not, by itself, represent years of experience in every service area presented.</p>
        </div>
        <aside class="identity-panel" aria-label="Company identification">
          <p class="panel-label">COMPANY IDENTIFICATION</p>
          <h3>HMATIAS – Prestação de Serviços, (SU), Lda.</h3>
          <dl>
            <div><dt>Tax ID (NIF)</dt><dd>{company.taxNumber}</dd></div>
            <div><dt>Commercial registration</dt><dd>{company.commercialRegistration}</dd></div>
            <div><dt>Company registration</dt><dd>24094-23/230713</dd></div>
            <div><dt>Registered address</dt><dd>Rua A, No. 31, Bairro 1.º de Maio, Viana, Luanda</dd></div>
            <div><dt>Representation</dt><dd>Henrique Fernandes Matias — Sole Shareholder and Managing Director</dd></div>
          </dl>
        </aside>
      </div>
    </section>

    <section class="dossier-sheet" aria-labelledby="dossier-services-heading">
      <div class="sheet-head"><p class="section-kicker">02 / AREAS OF ACTIVITY</p><span class="sheet-number">02</span></div>
      <div class="services-intro">
        <h2 id="dossier-services-heading">Integrated services<br /><em>around real needs.</em></h2>
        <p>The institutional offer combines execution, operational support and supply coordination. Each service depends on the definition of scope, resources, conditions and applicable requirements.</p>
      </div>
      <div class="service-grid">
        <article><span>01</span><h3>Civil construction</h3><p>Construction works, concreting, paving, masonry, infrastructure and supporting works.</p></article>
        <article><span>02</span><h3>Remodelling</h3><p>Adaptation, renovation and improvement of business, commercial and residential spaces.</p></article>
        <article><span>03</span><h3>Facilities services</h3><p>Maintenance, cleaning, conservation and operational support for continuously used facilities.</p></article>
        <article><span>04</span><h3>Business supply</h3><p>Materials, consumables, equipment and products required for business and project operations.</p></article>
        <article><span>05</span><h3>Procurement &amp; Supply</h3><p>Market research, supplier enquiries and comparisons, proposal structuring and purchasing and delivery coordination.</p></article>
        <article><span>06</span><h3>Business support</h3><p>Document organisation, operational support and process administration within the agreed scope.</p></article>
      </div>
    </section>

    <section class="dossier-sheet" aria-labelledby="dossier-works-heading">
      <div class="sheet-head"><p class="section-kicker">03 / WORK RECORDS</p><span class="sheet-number">03</span></div>
      <div class="works-intro">
        <h2 id="dossier-works-heading">Documented records.<br /><em>Work on the ground.</em></h2>
        <p>A selection of visual records from HMATIAS activities. Captions describe observable elements and do not attribute clients, values, dates or dimensions that are not documented.</p>
      </div>
      <div class="works-grid">
        {projects.map((project) => (
          <article class="work-card">
            <figure><Picture src={project.image} alt={project.alt} widths={[360, 560, 760]} sizes="(max-width: 680px) 100vw, 44vw" formats={["avif", "webp"]} fallbackFormat="jpg" quality={82} decoding="async" loading="lazy" /></figure>
            <div><p class="work-category">{project.category}</p><h3>{project.title}</h3><p>{project.description}</p></div>
          </article>
        ))}
      </div>
      <p class="evidence-note">Photographic records demonstrate visible work types and stages. They do not replace contracts, measurement records, handover certificates, certificates or other project-specific evidence.</p>
    </section>

    <section class="dossier-sheet" aria-labelledby="dossier-method-heading">
      <div class="sheet-head"><p class="section-kicker">04 / WORKING METHOD</p><span class="sheet-number">04</span></div>
      <div class="method-intro">
        <h2 id="dossier-method-heading">From request<br /><em>to delivery.</em></h2>
        <p>Work is organised around the actual requirement, the client's specifications and the conditions confirmed for each operation.</p>
      </div>
      <ol class="method-steps">
        <li><span>01</span><div><h3>Understand the requirement</h3><p>Review the request, context, specifications, quantities, destination, timeline and priorities.</p></div></li>
        <li><span>02</span><div><h3>Define the scope</h3><p>Clarify the work, deliverables, resources, responsibilities, budget and execution conditions.</p></div></li>
        <li><span>03</span><div><h3>Organise and execute</h3><p>Coordinate the people, materials and resources required, following the accepted scope.</p></div></li>
        <li><span>04</span><div><h3>Follow up delivery</h3><p>Maintain communication on timing, quality, documentation and completion of the agreed deliverables.</p></div></li>
      </ol>
      <div class="supply-method">
        <p class="panel-label">PROCUREMENT &amp; SUPPLY</p>
        <h3>Source. Compare. Coordinate.</h3>
        <p>For supply requests, HMATIAS clarifies specifications and quantities, consults the market, compares options and coordinates purchasing and delivery according to the responsibilities agreed for each operation.</p>
        <p class="note">Stock availability, origin, price, lead time and logistics are not assumed: each element is confirmed for the specific request. This dossier does not present a supply operation without documentary evidence as a completed delivery.</p>
      </div>
    </section>

    <section class="dossier-sheet" aria-labelledby="dossier-governance-heading">
      <div class="sheet-head"><p class="section-kicker">05 / MANAGEMENT AND CREDIBILITY</p><span class="sheet-number">05</span></div>
      <h2 id="dossier-governance-heading">Responsibility<br /><em>and institutional rigour.</em></h2>
      <div class="governance-grid">
        <div class="management-card">
          <p class="panel-label">LEADERSHIP</p>
          <h3>Henrique Fernandes Matias</h3>
          <p>Sole Shareholder and Managing Director</p>
          <p>Management oversees the company's administrative, commercial and operational organisation, including scope definition and the conditions of each proposal.</p>
        </div>
        <div class="integrity-card">
          <p class="panel-label">INFORMATION STANDARDS</p>
          <ul>
            <li>Do not attribute clients, references or certifications without evidence and authorisation.</li>
            <li>Do not present projects under development as completed.</li>
            <li>Do not confuse service capability with proof of execution.</li>
            <li>Confirm requirements, qualifications, timelines and conditions before undertaking commitments.</li>
          </ul>
        </div>
      </div>
      <p class="legal-note">This dossier is an institutional document. It does not replace permits, licences, certificates, declarations, contracts or other documents required by each client, contracting authority or qualification procedure. Original legal and tax documentation prevails for verification and contracting purposes.</p>
    </section>

    <section class="dossier-sheet contacts-sheet" aria-labelledby="dossier-contacts-heading">
      <div class="sheet-head"><p class="section-kicker">06 / INSTITUTIONAL CONTACT</p><span class="sheet-number">06</span></div>
      <div class="contacts-copy">
        <p class="section-kicker">HMATIAS · VIANA · LUANDA</p>
        <h2 id="dossier-contacts-heading">Let's discuss<br /><em>your requirement.</em></h2>
        <p>For quotation requests, supplier qualification, partnerships or institutional information, please use HMATIAS' official channels.</p>
      </div>
      <div class="contact-grid">
        <div><span>COMPANY</span><strong>HMATIAS – Prestação de Serviços, (SU), Lda.</strong></div>
        <div><span>TAX ID</span><strong>{company.taxNumber}</strong></div>
        <div><span>REGISTERED ADDRESS</span><strong>{company.address}</strong></div>
        <div><span>TELEPHONE</span><strong><a href={company.telephoneUri}>{company.phone}</a></strong></div>
        <div><span>GENERAL EMAIL</span><strong><a href={"mailto:"+company.commercialEmail}>{company.commercialEmail}</a></strong></div>
        <div><span>COMMERCIAL EMAIL</span><strong><a href={"mailto:"+company.institutionalEmail}>{company.institutionalEmail}</a></strong></div>
        <div><span>WEBSITE</span><strong><a href="https://comercialhmatiasps.com">comercialhmatiasps.com</a></strong></div>
        <div><span>COMMERCIAL REGISTRATION</span><strong>{company.commercialRegistration}</strong></div>
      </div>
      <div class="closing-line"><span>CONSTRUCTION · INFRASTRUCTURE · FACILITIES · SUPPLY</span><span>INSTITUTIONAL EDITION · 2026</span></div>
      <div class="final-actions no-print">
        <button type="button" class="print-button" data-print-dossier>Print / save as PDF <span aria-hidden="true">↗</span></button>
        <a href="/en/credibility/">View company information <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
  <SiteFooter />
  <div class="preview-disclaimer">Independent technology preview. It does not replace or modify the official HMATIAS website.</div>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-print-dossier]").forEach((button) => {
    button.addEventListener("click", () => window.print());
  });
</script>

<style>
.dossier-page { padding:30px var(--hm-gutter) 76px; background:var(--hm-light); }
.dossier-sheet { position:relative; max-width:1120px; margin:0 auto 22px; padding:clamp(30px,5.3vw,68px); background:var(--hm-paper); border:1px solid var(--hm-line); }
.dossier-cover { position:relative; overflow:hidden; min-height:680px; display:flex; flex-direction:column; justify-content:space-between; color:#fff; background:var(--hm-navy); border:0; }
.cover-image { position:absolute; inset:0; z-index:0; margin:0; }
.cover-image img { display:block; width:100%; height:100%; object-fit:cover; }
.cover-image:after { position:absolute; inset:0; content:""; background:linear-gradient(110deg,rgba(4,33,61,.94),rgba(4,33,61,.54)); }
.cover-top,.cover-bottom,.sheet-head { display:flex; justify-content:space-between; align-items:center; gap:24px; }
.cover-top,.cover-bottom,.cover-copy,.cover-action { position:relative; z-index:1; }
.cover-top img { width:118px; height:auto; padding:9px; background:#fff; }
.cover-top > span,.cover-bottom { color:#dceafa; font-size:9px; font-weight:700; line-height:1.8; letter-spacing:.14em; }
.cover-top > span { text-align:right; }
.cover-copy { max-width:760px; margin:75px 0; }
.section-kicker,.panel-label { margin:0; color:var(--hm-blue); font-size:9px; font-weight:750; letter-spacing:.16em; }
.cover-copy .section-kicker { color:#a9d4f1; }
.cover-copy h1 { margin:25px 0 0; font-size:clamp(42px,7vw,84px); line-height:.99; font-weight:520; letter-spacing:-.065em; }
.cover-copy h1 em { color:#b9d8ed; font-family:var(--hm-serif); font-weight:400; }
.cover-copy > p:last-child { max-width:590px; margin:27px 0 0; color:#e2edf7; font-size:14px; line-height:1.9; }
.cover-bottom { flex-wrap:wrap; padding-top:20px; border-top:1px solid #ffffff55; }
.cover-action,.final-actions { display:flex; align-items:center; flex-wrap:wrap; gap:22px; margin-top:26px; }
.cover-action a,.final-actions a { color:inherit; font-size:11px; text-decoration:underline; text-underline-offset:4px; }
.print-button { display:inline-flex; align-items:center; gap:22px; padding:14px 18px; color:#082f52; background:#d8ebf8; border:1px solid #b9d8ed; font:inherit; font-size:11px; font-weight:700; cursor:pointer; }
.print-button:hover { background:#fff; }
.sheet-head { padding-bottom:15px; border-bottom:1px solid var(--hm-line); }
.sheet-number { color:var(--hm-blue); font-family:var(--hm-serif); font-size:20px; }
.profile-grid { display:grid; grid-template-columns:1fr .9fr; gap:clamp(32px,6vw,76px); margin-top:54px; }
.dossier-sheet h2 { margin:20px 0 0; color:var(--hm-ink); font-size:clamp(35px,5vw,60px); line-height:1.04; font-weight:520; letter-spacing:-.06em; }
.dossier-sheet h2 em { color:var(--hm-blue); font-family:var(--hm-serif); font-weight:400; }
.profile-grid .lead { max-width:610px; margin:25px 0 0; color:var(--hm-ink); font-size:16px; line-height:1.85; }
.profile-grid > div > p:not(.lead) { max-width:610px; margin:17px 0 0; color:var(--hm-muted); font-size:12px; line-height:1.9; }
.note,.legal-note,.evidence-note { color:var(--hm-muted); font-size:10px; line-height:1.8; }
.identity-panel { align-self:start; padding:28px; background:var(--hm-light); border:1px solid var(--hm-line); }
.identity-panel h3 { margin:16px 0 22px; font-size:19px; line-height:1.45; }
.identity-panel dl { margin:0; border-top:1px solid var(--hm-line); }
.identity-panel dl div { display:grid; grid-template-columns:.72fr 1.28fr; gap:16px; padding:12px 0; border-bottom:1px solid var(--hm-line); font-size:10px; }
.identity-panel dt { color:var(--hm-muted); }
.identity-panel dd { margin:0; text-align:right; font-weight:650; overflow-wrap:anywhere; }
.services-intro,.works-intro,.method-intro { display:grid; grid-template-columns:1fr .8fr; align-items:end; gap:30px; margin:48px 0 35px; }
.services-intro h2,.works-intro h2,.method-intro h2 { margin:0; }
.services-intro > p,.works-intro > p,.method-intro > p { max-width:440px; margin:0; color:var(--hm-muted); font-size:12px; line-height:1.9; }
.service-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
.service-grid article { min-height:160px; padding:24px; border:1px solid var(--hm-line); background:#fff; }
.service-grid article > span { color:var(--hm-blue); font-family:var(--hm-serif); font-size:20px; }
.service-grid h3 { margin:20px 0 9px; font-size:15px; }
.service-grid p { margin:0; color:var(--hm-muted); font-size:11px; line-height:1.8; }
.works-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; }
.work-card { overflow:hidden; border:1px solid var(--hm-line); background:#fff; }
.work-card figure { margin:0; aspect-ratio:16/10; background:var(--hm-sky-soft); }
.work-card img { display:block; width:100%; height:100%; object-fit:cover; }
.work-card > div { padding:18px 20px 21px; }
.work-category { margin:0; color:var(--hm-blue); font-size:9px; font-weight:750; letter-spacing:.12em; text-transform:uppercase; }
.work-card h3 { margin:10px 0 7px; font-size:14px; }
.work-card > div > p:last-child { margin:0; color:var(--hm-muted); font-size:10px; line-height:1.75; }
.evidence-note { margin:20px 0 0; padding-top:16px; border-top:1px solid var(--hm-line); }
.method-steps { margin:40px 0 0; padding:0; list-style:none; border-top:1px solid var(--hm-line); }
.method-steps li { display:grid; grid-template-columns:48px 1fr; gap:18px; padding:22px 0; border-bottom:1px solid var(--hm-line); }
.method-steps li > span { color:var(--hm-blue); font-family:var(--hm-serif); font-size:20px; }
.method-steps h3 { margin:0 0 8px; font-size:14px; }
.method-steps p { max-width:690px; margin:0; color:var(--hm-muted); font-size:11px; line-height:1.8; }
.supply-method { margin-top:34px; padding:26px; color:#fff; background:var(--hm-navy); }
.supply-method .panel-label { color:#b9d8ed; }
.supply-method h3 { margin:15px 0 12px; font-size:22px; font-weight:520; }
.supply-method p:not(.panel-label) { max-width:760px; color:#dceafa; font-size:11px; line-height:1.85; }
.supply-method .note { color:#b8cbdc !important; }
.governance-sheet > h2 { margin-top:54px; }
.governance-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-top:38px; }
.management-card,.integrity-card { padding:27px; border:1px solid var(--hm-line); background:var(--hm-light); }
.management-card h3 { margin:22px 0 6px; font-family:var(--hm-serif); font-size:25px; font-weight:400; }
.management-card > p:not(.panel-label) { color:var(--hm-muted); font-size:11px; line-height:1.85; }
.integrity-card ul { margin:18px 0 0; padding-left:18px; }
.integrity-card li { margin:0 0 12px; color:var(--hm-muted); font-size:11px; line-height:1.8; }
.legal-note { margin:30px 0 0; padding-top:18px; border-top:1px solid var(--hm-line); }
.contacts-sheet { color:#fff; background:var(--hm-navy); border-color:var(--hm-navy); }
.contacts-sheet .section-kicker { color:#a9d4f1; }
.contacts-sheet h2 { color:#fff; }
.contacts-sheet h2 em { color:#b9d8ed; }
.contacts-copy { max-width:720px; margin:55px 0 36px; }
.contacts-copy > p:last-child { max-width:520px; margin:20px 0 0; color:#dceafa; font-size:12px; line-height:1.9; }
.contact-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); border-top:1px solid #ffffff55; }
.contact-grid > div { display:flex; flex-direction:column; gap:9px; padding:18px 18px 18px 0; border-bottom:1px solid #ffffff55; }
.contact-grid span { color:#a9d4f1; font-size:8px; font-weight:750; letter-spacing:.14em; }
.contact-grid strong { color:#fff; font-size:11px; font-weight:600; line-height:1.65; overflow-wrap:anywhere; }
.contact-grid a { text-decoration:underline; text-underline-offset:3px; }
.closing-line { display:flex; justify-content:space-between; gap:16px; margin-top:45px; padding-top:18px; border-top:1px solid #ffffff55; color:#dceafa; font-size:8px; font-weight:700; letter-spacing:.12em; }
.final-actions { color:#fff; }
@media (max-width:760px) {
  .dossier-page { padding:12px 10px 45px; }
  .dossier-sheet { padding:27px 21px; margin-bottom:12px; }
  .dossier-cover { min-height:600px; }
  .profile-grid,.services-intro,.works-intro,.method-intro,.governance-grid { grid-template-columns:1fr; }
  .profile-grid { margin-top:32px; }
  .services-intro,.works-intro,.method-intro { margin:34px 0 24px; }
  .works-grid,.service-grid,.contact-grid { grid-template-columns:1fr; }
  .cover-copy h1 { font-size:clamp(39px,11vw,60px); }
  .identity-panel { padding:21px; }
  .identity-panel dl div { grid-template-columns:1fr; gap:5px; }
  .identity-panel dd { text-align:left; }
  .closing-line { flex-direction:column; }
}
@media print {
  @page { size:A4; margin:0; }
  html,body { width:210mm; margin:0 !important; background:#fff !important; }
  .preview-bar,.site-header,.site-footer,.preview-disclaimer,.no-print { display:none !important; }
  .dossier-page { padding:0 !important; background:#fff !important; }
  .dossier-sheet { width:210mm; max-width:none; min-height:297mm; margin:0; padding:18mm 17mm; border:0; box-shadow:none; break-after:page; page-break-after:always; }
  .dossier-sheet:last-child { break-after:auto; page-break-after:auto; }
  .dossier-cover { min-height:297mm; padding:18mm 17mm; print-color-adjust:exact; -webkit-print-color-adjust:exact; }
  .cover-image:after { print-color-adjust:exact; -webkit-print-color-adjust:exact; }
  .contacts-sheet,.supply-method { print-color-adjust:exact; -webkit-print-color-adjust:exact; }
  .work-card,.service-grid article,.management-card,.integrity-card,.identity-panel { break-inside:avoid; page-break-inside:avoid; }
  .works-grid { gap:8mm; }
  .work-card figure { aspect-ratio:16/9; }
  .work-card > div { padding:4mm; }
  .work-card h3 { font-size:10pt; }
  .work-card > div > p:last-child,.service-grid p,.method-steps p,.management-card > p:not(.panel-label),.integrity-card li { font-size:8pt; }
  .service-grid article { min-height:36mm; padding:5mm; }
  .service-grid h3 { margin:5mm 0 2mm; font-size:10pt; }
  .sheet-head { margin-bottom:4mm; }
  .dossier-sheet h2 { font-size:30pt; }
  .contacts-copy { margin-top:32mm; }
  a { color:inherit !important; }
}
</style>
