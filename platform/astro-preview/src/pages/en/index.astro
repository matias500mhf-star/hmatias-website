---
import { Picture } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import PartnerSection from "../../components/PartnerSection.astro";
import heroPhoto from "../../../../../images/catalogue/instalacoes-embutidas-construcao.webp";
import metalStructure from "../../../../../images/catalogue/galpao-estrutura-metalica.webp";
import sitePreparation from "../../../../../images/catalogue/terraplanagem-preparacao-terreno.webp";
import roofWorks from "../../../../../images/catalogue/cobertura-metalica-substituicao.webp";
import ruralPavilions from "../../../../../images/catalogue/pavilhoes-rurais-concluidos.webp";
import { company } from "../../data/site";
---
<BaseLayout
  title="HMATIAS | Construction, Facilities, Supply and Business Services in Angola"
  description="Construction, maintenance, procurement and business support for companies and projects in Angola."
  lang="en"
>
  <div class="preview-bar"><span><i aria-hidden="true"></i> ASTRO TECHNOLOGY PREVIEW</span><span>HMATIAS · ENGLISH VERSION</span></div>
  <SiteHeader />
  <main>
    <section class="hero" id="inicio" aria-labelledby="pages-en-index-section-1-heading">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-line"></span> CONSTRUCTION · FACILITIES · SUPPLY · BUSINESS SERVICES</p>
        <h1 id="pages-en-index-section-1-heading">Capability to<br /><em>make it happen.</em></h1>
        <p class="hero-lead">Construction, facilities, procurement and business support for companies and projects in Angola.</p>
        <div class="hero-actions">
          <a class="button button-light" href="#services">Explore our services <span aria-hidden="true">↓</span></a>
          <a class="text-link text-link-light" href={company.whatsappUri} target="_blank" rel="noopener noreferrer">Contact our team <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-meta"><span>{company.name}</span><span>Viana, Luanda · Angola</span></div>
      </div>
      <div class="hero-image-wrap">
        <Picture src={heroPhoto} alt="Building interior under construction, with visible block walls, pipes and technical boxes" widths={[640,960,1280]} sizes="(max-width: 900px) 100vw, 50vw" formats={["avif", "webp"]} fallbackFormat="jpg" quality={84} loading="eager" fetchpriority="high" decoding="async" />
        <div class="image-index"><span>01</span><span>MASONRY · VISIBLE TECHNICAL INSTALLATIONS</span></div>
      </div>
      <div class="hero-side-note">DELIVERY · SUPPLY · OPERATIONS</div>
    </section>

    <section class="intro section-pad" id="company" aria-labelledby="pages-en-index-section-2-heading">
      <div class="section-kicker">01 / WHO WE ARE</div>
      <div class="intro-content">
        <h2 id="pages-en-index-section-2-heading">A service company.<br /><em>Four areas of delivery.</em></h2>
        <div class="intro-text">
          <p>HMATIAS supports companies, institutions and private clients through construction and remodelling, facilities and maintenance, procurement and supply, and administrative and business services.</p>
          <p>From the initial requirement to delivery: clear scope, direct communication and follow-up throughout the agreed work.</p>
          <a class="underlined-link" href="/en/about/">Meet HMATIAS <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="services section-pad" id="services" aria-labelledby="pages-en-index-section-3-heading">
      <div class="section-heading">
        <div><div class="section-kicker">02 / WHAT WE DO</div><h2 id="pages-en-index-section-3-heading">Services designed<br /><em>around real requirements.</em></h2></div>
        <p>Four service areas, one point of contact to assess the requirement and define a suitable scope of work.</p>
      </div>
      <div class="service-list">
        <a class="service-row" href="/en/construction/"><span class="service-number">01</span><span class="service-icon" aria-hidden="true">⌂</span><span class="service-main"><strong>Construction and remodelling</strong><small>Buildings · Infrastructure · Paving · Finishes</small></span><span class="service-arrow">↗</span></a>
        <a class="service-row" href="/en/facilities/"><span class="service-number">02</span><span class="service-icon" aria-hidden="true">⌘</span><span class="service-main"><strong>Facilities and maintenance</strong><small>Building maintenance · Cleaning · Operational support</small></span><span class="service-arrow">↗</span></a>
        <a class="service-row" href="/en/supply/"><span class="service-number">03</span><span class="service-icon" aria-hidden="true">▤</span><span class="service-main"><strong>Supply and procurement</strong><small>Sourcing · Materials · Consumables · Equipment</small></span><span class="service-arrow">↗</span></a>
        <a class="service-row" href="/en/business-services/"><span class="service-number">04</span><span class="service-icon" aria-hidden="true">▣</span><span class="service-main"><strong>Business Services</strong><small>Administrative support · Documentation · Business services</small></span><span class="service-arrow">↗</span></a>
      </div>
      <div class="services-foot"><span>01—04</span><span>HMATIAS SERVICE AREAS</span></div>
    </section>


    <section class="portfolio section-pad" id="projects" aria-labelledby="pages-en-index-section-4-heading">
      <div class="portfolio-top">
        <div><div class="section-kicker">03 / VISUAL REFERENCES</div><h2 id="pages-en-index-section-4-heading">Construction elements<br /><em>and visible stages.</em></h2></div>
        <p>A selection of construction elements and execution stages in the visual archive. Captions describe only what can be observed.</p>
      </div>
      <div class="project-grid">
        <article class="project-card"><figure class="project-photo"><Picture src={metalStructure} alt="Galvanised metal structure and roof sheeting on a building" widths={[640,960]} sizes="(max-width:700px) 100vw, 50vw" formats={["avif", "webp"]} fallbackFormat="jpg" quality={82} decoding="async" loading="lazy" /></figure><div class="project-caption"><span>METAL STRUCTURES</span><h3>Metal structure and supporting masonry</h3><p>Metal structure, sheet roof covering and supporting masonry visible during an execution stage.</p></div></article>
        <article class="project-card"><figure class="project-photo"><Picture src={sitePreparation} alt="Earthmoving equipment on natural ground, with excavated and levelled material visible" widths={[640,960]} sizes="(max-width:700px) 100vw, 50vw" formats={["avif", "webp"]} fallbackFormat="jpg" quality={82} decoding="async" loading="lazy" /></figure><div class="project-caption"><span>INFRASTRUCTURE</span><h3>Earthmoving equipment on natural ground</h3><p>Earthmoving equipment on natural ground, with excavated and levelled material visible.</p></div></article>
        <article class="project-card"><figure class="project-photo"><Picture src={roofWorks} alt="New profiled sheets beside existing sheets on a roof under intervention" widths={[640,960]} sizes="(max-width:700px) 100vw, 50vw" formats={["avif", "webp"]} fallbackFormat="jpg" quality={82} decoding="async" loading="lazy" /></figure><div class="project-caption"><span>FACILITIES · MAINTENANCE</span><h3>Profiled roof sheets</h3><p>New profiled sheets positioned beside existing sheets on a roof under intervention.</p></div></article>
        <article class="project-card"><figure class="project-photo"><Picture src={ruralPavilions} alt="Two elongated pavilions with metal roofing and partially open sides" widths={[640,960]} sizes="(max-width:700px) 100vw, 50vw" formats={["avif", "webp"]} fallbackFormat="jpg" quality={82} decoding="async" loading="lazy" /></figure><div class="project-caption"><span>RURAL CONSTRUCTION</span><h3>Rural pavilions with metal roofing</h3><p>Two elongated pavilions with metal roofing and partially open sides.</p></div></article>
      </div>
      <div class="portfolio-note"><span>VISUAL ARCHIVE · VISIBLE ELEMENTS</span><span>HMATIAS · ANGOLA</span></div>
      <a class="underlined-link" href="/en/works-catalogue/">View the works catalogue <span aria-hidden="true">↗</span></a>
    </section>

    <section class="supply-home-highlight section-pad" aria-labelledby="supply-home-heading">
      <div class="supply-home-copy">
        <p class="section-kicker">SUPPLY / PROCUREMENT & BUSINESS SUPPLY</p>
        <h2 id="supply-home-heading">Supply shaped<br /><em>around real requirements.</em></h2>
        <p>We support businesses in sourcing materials, consumables, equipment, PPE and other supply requirements. Each proposal is prepared against the client's specification, quantity, destination and required timing.</p>
        <a class="button button-dark" href="/en/supply/">Explore Supply and catalogues <span aria-hidden="true">↗</span></a>
      </div>
      <div class="supply-home-points" aria-label="HMATIAS supply model">
        <div><span>01</span><p><strong>Specification-led sourcing</strong><small>Reference, application and technical requirements.</small></p></div>
        <div><span>02</span><p><strong>Commercial verification</strong><small>Availability, documentation and terms subject to confirmation.</small></p></div>
        <div><span>03</span><p><strong>Quotation request</strong><small>A clear route to submit a supply requirement.</small></p></div>
      </div>
    </section>
    <PartnerSection />

    <section class="statement" aria-labelledby="pages-en-index-section-5-heading">
      <div class="statement-mark" aria-hidden="true">“</div>
      <div class="statement-content">
        <h2 id="pages-en-index-section-5-heading">Every project starts with a clear conversation about what needs to be done.</h2><a class="button button-dark" href="#contact">Submit a requirement <span aria-hidden="true">↗</span></a></div>
      <span class="statement-label">HMATIAS · AO</span>
    </section>

    <section class="contact section-pad" id="contact" aria-labelledby="pages-en-index-section-6-heading">
      <div class="contact-grid">
        <div class="contact-copy"><div class="section-kicker">04 / CONTACT</div><h2 id="pages-en-index-section-6-heading">Let's discuss<br /><em>your project.</em></h2><p>Share the service required, the location and what you intend to achieve. The HMATIAS team can review the request and outline the next steps.</p><div class="contact-details"><a href={company.telephoneUri}>{company.phone}</a><a href={`mailto:${company.commercialEmail}`}>{company.commercialEmail}</a><a href={`mailto:${company.institutionalEmail}`}>{company.institutionalEmail}</a><span class="contact-address">{company.address}</span></div></div>
        <div class="contact-actions"><a class="contact-action" href={company.whatsappUri} target="_blank" rel="noopener noreferrer">Contact us on WhatsApp <b>↗</b></a><a class="contact-action" href={`mailto:${company.commercialEmail}?subject=HMATIAS%20service%20enquiry`}>Send an email <b>↗</b></a><a class="contact-action" href={company.contactFormEnUrl} target="_blank" rel="noopener noreferrer">Open official contact form <b>↗</b></a><a class="contact-action" href="/en/source-ao/smart-rfq/">Prepare a supply request <b>↗</b></a><p class="contact-small">A submitted enquiry is subject to review and does not constitute acceptance of a contract or confirmation of supply availability.</p></div>
      </div>
    </section>
  </main>
  <SiteFooter />
  <div class="preview-disclaimer">Independent technology preview. It does not replace or modify the official HMATIAS website.</div>
<style>
.supply-home-highlight{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(260px,.85fr);gap:clamp(32px,7vw,100px);align-items:center;background:var(--hm-light)}
.supply-home-copy h2,.supply-catalogue-copy h2{margin:18px 0 20px;font-family:var(--hm-serif);font-size:clamp(34px,5vw,62px);font-weight:450;line-height:1.04;letter-spacing:-.045em}
.supply-home-copy h2 em,.supply-catalogue-copy h2 em{font-weight:400}
.supply-home-copy>p:not(.section-kicker),.supply-catalogue-copy>p:not(.section-kicker){max-width:650px;color:var(--hm-muted);font-size:14px;line-height:1.85}
.supply-home-copy .button{margin-top:18px}
.supply-home-points{border-top:1px solid var(--hm-line)}
.supply-home-points>div{display:grid;grid-template-columns:38px 1fr;gap:14px;padding:20px 0;border-bottom:1px solid var(--hm-line)}
.supply-home-points>div>span{color:var(--hm-blue);font-family:var(--hm-serif);font-size:18px}
.supply-home-points p{display:grid;gap:5px;margin:0}
.supply-home-points strong{color:var(--hm-ink);font-size:13px;font-weight:650}
.supply-home-points small{color:var(--hm-muted);font-size:11px;line-height:1.65}
.supply-catalogue-note{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(230px,.8fr);gap:40px;align-items:center;background:var(--hm-light)}
.supply-catalogue-action{padding:25px;border:1px solid var(--hm-line);background:var(--hm-paper)}
.supply-catalogue-action p{margin:0 0 18px;color:var(--hm-ink);font-size:15px;line-height:1.6}
.supply-catalogue-action small{display:block;margin-top:14px;color:var(--hm-muted);font-size:11px;line-height:1.65}
@media(max-width:760px){.supply-home-highlight,.supply-catalogue-note{grid-template-columns:1fr;gap:26px}.supply-catalogue-action{padding:20px}}
</style>
</BaseLayout>