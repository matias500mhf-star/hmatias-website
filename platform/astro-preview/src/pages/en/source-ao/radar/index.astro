---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SourceAoOpportunityRadar from "../../../../components/SourceAoOpportunityRadar.astro";

const candidateApiBase = String(import.meta.env.PUBLIC_SOURCE_AO_API_BASE ?? "").trim();
let sourceAoApiBase = "";
try {
  const parsed = new URL(candidateApiBase);
  if (parsed.protocol === "https:" && parsed.hostname.toLowerCase().includes("staging")) {
    sourceAoApiBase = parsed.origin;
  }
} catch {
  sourceAoApiBase = "";
}
---
<BaseLayout
  title="Opportunity Radar · SOURCE AO"
  description="Public procurement opportunities in Angola, filtered by business area, deadline, source and commercial fit. Publication requires review."
  lang="en"
>
  <SourceAoOpportunityRadar apiBase={sourceAoApiBase} lang="en" />
</BaseLayout>
