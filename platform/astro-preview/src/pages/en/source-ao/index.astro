---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import sourceLogo from "../../../../../../images/source-ao-logo.svg";
import { company } from "../../../data/site";
---
<BaseLayout title="SOURCE AO — Sourcing and supply verification in Angola" description="Structure purchasing requirements, identify market references and submit sourcing requests for commercial verification in Angola." lang="en">
  <div class="source-preview-bar"><span>SOURCE AO</span><span>PREVIEW · DIGITAL PRODUCT</span></div>
  <header class="source-header">
    <a href="/en/source-ao/" aria-label="SOURCE AO — home"><Image src={sourceLogo} alt="SOURCE AO" width={190} height={90} /></a>
    <nav aria-label="SOURCE AO navigation"><a href="#process">Process</a><a href="#markets">Markets</a><a href="/en/source-ao/smart-rfq/">Smart RFQ</a></nav>
    <a class="source-lang" href="/source-ao/">PT</a>
  </header>
  <main>
    <section class="source-hero" aria-labelledby="pages-en-source-ao-index-section-1-heading"><div class="source-hero-copy">
      <p class="source-kicker">SOURCING · PROCUREMENT · ANGOLA</p>
      <h1 id="pages-en-source-ao-index-section-1-heading">From a buying need to a <em>viable supply option.</em></h1>
      <p class="source-lead">Describe the material, equipment or service. SOURCE AO structures the requirement, identifies market references and routes the request for commercial verification by HMATIAS.</p>
      <div class="source-actions"><a class="source-button" href="/en/source-ao/smart-rfq/">Start a sourcing request <span>↗</span></a><a class="source-secondary" href="#process">See how it works ↓</a></div>
      <p class="source-truth">A public reference is not confirmed stock. Price, availability, lead time and transport are checked before any commercial proposal.</p>
    </div><aside class="source-brief"><div class="brief-top"><span>01 / REQUEST</span><span>AO</span></div><h2>What do you need to buy?</h2><p>A clear request starts with information that makes options comparable.</p><ul><li>Product or service</li><li>Standard, brand or specification</li><li>Quantity and unit</li><li>Destination and required date</li></ul><a href="/en/source-ao/smart-rfq/">Prepare a Smart RFQ ↗</a></aside></section>
    <section class="source-process" id="process" aria-labelledby="pages-en-source-ao-index-section-2-heading"><div class="source-section-label">02 / WORKING METHOD</div><div class="source-process-head"><h2 id="pages-en-source-ao-index-section-2-heading">Four steps.<br/><em>No premature promises.</em></h2><p>SOURCE AO separates research, evidence and confirmation. Each step has an identifiable outcome.</p></div><div class="source-steps"><article><span>01</span><h3>Structure</h3><p>Organise item, specification, quantity, destination and timing.</p></article><article><span>02</span><h3>Research</h3><p>Identify relevant suppliers, catalogues and market references.</p></article><article><span>03</span><h3>Verify</h3><p>Contact options and check identity, availability and terms.</p></article><article><span>04</span><h3>Present</h3><p>Prepare a commercial response with verified options and conditions.</p></article></div></section>
    <section class="source-markets" id="markets" aria-labelledby="pages-en-source-ao-index-section-3-heading"><div><p class="source-kicker">03 / MARKET COVERAGE</p><h2 id="pages-en-source-ao-index-section-3-heading">Angola first.<br/><em>Regional sourcing when needed.</em></h2><p>The geographic scope is explicit: commercial opportunities are monitored in Angola; cross-border research is used to locate materials and equipment for supply into the Angolan market.</p></div><div class="market-list"><article><b>AO</b><div><strong>Angola</strong><span>Primary market · tenders, RFQs, buying requirements and local sourcing.</span></div></article><article><b>NA</b><div><strong>Namibia</strong><span>Materials and equipment research for supply into Angola.</span></div></article><article><b>ZA</b><div><strong>South Africa</strong><span>Materials and equipment research for supply into Angola.</span></div></article></div></section>
    <section class="source-rfq" aria-labelledby="pages-en-source-ao-index-section-4-heading"><div><p class="source-kicker">04 / SMART RFQ</p><h2 id="pages-en-source-ao-index-section-4-heading">Submit a request that can be actioned.</h2><p>Record your requirements in a structured format. Review the details before sending them to the HMATIAS commercial team.</p></div><a class="source-button" href="/en/source-ao/smart-rfq/">Explore Smart RFQ ↗</a></section>
  </main>
  <footer class="source-footer"><a href="/en/source-ao/">SOURCE AO</a><span>A sourcing platform operated by HMATIAS.</span><a href="/en/privacy/">Privacy</a><a href="/en/terms/">Terms</a><a href={company.whatsappUri}>Commercial contact ↗</a></footer>
</BaseLayout>
<style>
/* The English preview uses the same SOURCE AO design system as the Portuguese page. */
:root{--sa-ink:#10283b;--sa-navy:#071f34;--sa-blue:#1265a5;--sa-pale:#eaf2f8;--sa-muted:#647789;--sa-line:#d7e0e8}
.source-preview-bar{display:flex;justify-content:space-between;padding:10px clamp(20px,5vw,76px);background:#061827;color:#b8cddd;font-size:9px;letter-spacing:.15em;font-weight:700}.source-header{height:82px;padding:0 clamp(20px,5vw,76px);display:flex;align-items:center;justify-content:space-between;background:#fff;border-bottom:1px solid var(--sa-line)}.source-header img{width:142px;height:auto}.source-header nav{display:flex;gap:34px}.source-header nav a,.source-lang{font-size:11px;color:var(--sa-ink);text-decoration:none;font-weight:650}.source-lang{border:1px solid var(--sa-line);padding:9px 12px}.source-hero{padding:clamp(60px,8vw,110px) clamp(20px,8vw,120px);display:grid;grid-template-columns:minmax(0,1.2fr) minmax(300px,.7fr);gap:clamp(40px,8vw,110px);align-items:center;background:var(--sa-navy);color:#fff}.source-hero-copy{max-width:740px}.source-kicker,.source-section-label{font-size:9px;font-weight:750;letter-spacing:.16em;color:#8db9d9}.source-hero h1{font-size:clamp(46px,6.4vw,84px);line-height:1.02;letter-spacing:-.065em;font-weight:540;margin:25px 0}.source-hero h1 em,.source-process-head h2 em,.source-markets h2 em{font-family:Georgia,serif;font-weight:400;color:#a9cce4}.source-lead{max-width:650px;color:#d8e5ef;font-size:15px;line-height:1.9}.source-actions{display:flex;gap:25px;align-items:center;flex-wrap:wrap;margin-top:32px}.source-button{display:inline-flex;align-items:center;justify-content:space-between;gap:25px;padding:16px 20px;background:#eaf3fa;color:#0a2c48;text-decoration:none;font-size:12px;font-weight:750}.source-secondary{color:#d8e5ef;font-size:11px;text-decoration:none}.source-truth{max-width:650px;margin-top:28px;color:#9eb4c5;font-size:10px;line-height:1.8}.source-brief{padding:30px;background:#fff;color:var(--sa-ink);box-shadow:14px 14px 0 #164e78}.brief-top{display:flex;justify-content:space-between;padding-bottom:16px;border-bottom:1px solid var(--sa-line);font-size:9px;font-weight:750;letter-spacing:.14em;color:var(--sa-blue)}.source-brief h2{font-size:24px;letter-spacing:-.04em;margin:25px 0 8px}.source-brief p,.source-brief li{font-size:11px;line-height:1.8;color:var(--sa-muted)}.source-brief ul{padding-left:18px;margin:20px 0}.source-brief>a{display:inline-block;padding-top:15px;border-top:1px solid var(--sa-line);width:100%;color:var(--sa-blue);font-size:11px;font-weight:750;text-decoration:none}.source-process{padding:80px clamp(20px,8vw,120px)}.source-section-label{color:var(--sa-blue)}.source-process-head{display:grid;grid-template-columns:1fr .7fr;gap:50px;align-items:end;margin-top:24px}.source-process-head h2,.source-markets h2,.source-rfq h2{font-size:clamp(35px,4.6vw,58px);line-height:1.08;letter-spacing:-.06em;font-weight:540;margin:0}.source-process-head h2 em,.source-markets h2 em{color:var(--sa-blue)}.source-process-head p,.source-markets>div:first-child>p:last-child,.source-rfq p{font-size:12px;line-height:1.9;color:var(--sa-muted);max-width:500px}.source-steps{display:grid;grid-template-columns:repeat(4,1fr);margin-top:48px;border-top:1px solid var(--sa-line)}.source-steps article{padding:24px 20px 10px 0;border-bottom:1px solid var(--sa-line)}.source-steps article+article{padding-left:20px;border-left:1px solid var(--sa-line)}.source-steps span{font-family:Georgia,serif;color:var(--sa-blue);font-size:19px}.source-steps h3{font-size:16px;margin:30px 0 8px}.source-steps p{font-size:11px;line-height:1.8;color:var(--sa-muted)}.source-markets{padding:80px clamp(20px,8vw,120px);display:grid;grid-template-columns:1fr .9fr;gap:clamp(40px,8vw,110px);background:var(--sa-pale)}.source-markets h2{margin:22px 0}.source-markets .source-kicker{color:var(--sa-blue)}.market-list{border-top:1px solid #cbd8e3}.market-list article{display:flex;gap:20px;padding:20px 0;border-bottom:1px solid #cbd8e3}.market-list b{display:grid;place-items:center;width:38px;height:38px;border:1px solid #9bb4c9;color:var(--sa-blue);font-size:11px}.market-list article div{display:grid;gap:5px}.market-list strong{font-size:13px}.market-list span{font-size:11px;line-height:1.7;color:var(--sa-muted)}.source-rfq{padding:70px clamp(20px,8vw,120px);display:flex;justify-content:space-between;gap:40px;align-items:center}.source-rfq .source-kicker{color:var(--sa-blue)}.source-rfq h2{margin:18px 0}.source-rfq p{max-width:600px}.source-footer{padding:25px clamp(20px,5vw,76px);background:#061827;color:#c4d3df;display:flex;gap:25px;align-items:center;justify-content:space-between;flex-wrap:wrap;font-size:10px}.source-footer a{color:#fff;text-decoration:none;font-weight:650}@media(max-width:800px){.source-hero,.source-process-head,.source-markets{grid-template-columns:1fr}.source-brief{max-width:520px}.source-steps{grid-template-columns:repeat(2,1fr)}.source-steps article:nth-child(3){padding-left:0;border-left:0}.source-rfq{align-items:flex-start;flex-direction:column}.source-header nav{gap:13px}.source-header nav a{font-size:10px}}@media(max-width:520px){.source-header{height:70px}.source-header img{width:112px}.source-header nav{gap:10px}.source-header nav a{font-size:9px}.source-hero h1{font-size:clamp(42px,12vw,58px)}.source-steps{grid-template-columns:1fr}.source-steps article,.source-steps article+article{padding:20px 0;border-left:0}.source-steps h3{margin:15px 0 8px}.source-footer{gap:13px}}
</style>
