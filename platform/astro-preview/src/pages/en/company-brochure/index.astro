---
import { Image, Picture } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import { company } from "../../../data/site";
import logo from "../../../../../../logo-hmatias.png";
import constructionPhoto from "../../../../../../images/catalogue/instalacoes-embutidas-construcao.webp";
import supplyPhoto from "../../../../../../images/catalogue/perfis-metalicos-estrutura.webp";
import "../../../styles/company-brochure.css";
---
<BaseLayout title="Company Brochure | HMATIAS" description="HMATIAS company brochure: company profile, business areas, service scope and official contacts." lang="en">
  <div class="preview-bar"><span><i aria-hidden="true"></i> HMATIAS · COMPANY BROCHURE</span><span>DIGITAL DOCUMENT · PRINT FORMAT</span></div><SiteHeader />
  <main class="brochure-page">
    <div class="brochure-toolbar"><div><span class="brochure-toolbar-label">HMATIAS / COMPANY PROFILE</span><p>Prepared for A4 printing or saving as a PDF.</p></div><button class="button button-dark" type="button" id="brochure-print">Print / save PDF <span>↗</span></button></div>
    <section class="brochure-sheet brochure-cover"><div class="brochure-head"><Image src={logo} alt="Official HMATIAS logo" widths={[160,240]} sizes="145px" format="webp" quality={90} /><span>COMPANY PROFILE · ANGOLA</span></div><div class="brochure-cover-grid"><div class="brochure-cover-copy"><p class="brochure-kicker">CONSTRUCTION · FACILITIES · SUPPLY · BUSINESS SERVICES</p><h1>Capability to<br /><em>make it happen.</em></h1><p>HMATIAS supports companies, institutions and private clients through construction and remodelling, facilities and maintenance, procurement and supply, and administrative and business support.</p><div class="brochure-meta"><span>Luanda · Angola</span><span>Since 2023</span></div></div><figure class="brochure-cover-photo"><Picture src={constructionPhoto} alt="HMATIAS project record showing masonry and concealed technical installations" widths={[640,960]} sizes="45vw" formats={["avif","webp"]} fallbackFormat="jpg" quality={90} loading="eager" decoding="async" /><figcaption>HMATIAS PROJECT PHOTOGRAPHIC RECORD</figcaption></figure></div><div class="brochure-footer"><span>HMATIAS - PRESTAÇÃO DE SERVIÇOS, (SU), LDA</span><span>01 / 04</span></div></section>
    <section class="brochure-sheet"><div class="brochure-page-head"><Image src={logo} alt="HMATIAS" widths={[100,150]} sizes="98px" format="webp" quality={88} /><span>02 / BUSINESS AREAS</span></div><div class="brochure-title"><p class="brochure-kicker">FOUR OPERATIONAL AREAS</p><h2>A service structure<br /><em>designed for delivery.</em></h2><p>Our business areas frame different requirements in a clear process, with scope and conditions defined before delivery.</p></div><div class="brochure-area-grid"><article><span>01</span><h3>Construction and remodelling</h3><p>Civil construction, space rehabilitation, site preparation, paving, roofing and metal structures.</p></article><article><span>02</span><h3>Facilities and maintenance</h3><p>Facility maintenance, professional cleaning, roof conservation and operational support.</p></article><article><span>03</span><h3>Supply and procurement</h3><p>Sourcing and supply of materials, industrial consumables, PPE, workwear, equipment and lubricants.</p></article><article><span>04</span><h3>Business Services</h3><p>Institutional writing, document organisation, commercial proposals, presentations and administrative support.</p></article></div><div class="brochure-note"><strong>Working model</strong><p>From requirement to proposal: understand the request, define the scope and confirm relevant conditions before any commitment.</p></div><div class="brochure-page-footer"><span>HMATIAS · Viana · Luanda · Angola</span><span>02 / 04</span></div></section>
    <section class="brochure-sheet"><div class="brochure-page-head"><Image src={logo} alt="HMATIAS" widths={[100,150]} sizes="98px" format="webp" quality={88} /><span>03 / CONSTRUCTION AND OPERATIONS</span></div><div class="brochure-heading"><p class="brochure-kicker">01 · CONSTRUCTION AND REMODELLING</p><h2>Building, rehabilitation<br /><em>and facility interventions.</em></h2></div><div class="brochure-split"><div class="brochure-copy"><p>HMATIAS undertakes civil construction and remodelling works, including interventions in existing facilities and infrastructure.</p><ul><li>Civil construction and space remodelling</li><li>Site preparation and paving</li><li>Roofing and metal structures</li><li>Office and supporting-area interventions</li></ul><a class="brochure-link" href="/en/construction/">Explore Construction and Remodelling ↗</a></div><figure class="brochure-photo"><Picture src={constructionPhoto} alt="HMATIAS construction work record" widths={[640,960]} sizes="45vw" formats={["avif","webp"]} fallbackFormat="jpg" quality={90} loading="lazy" decoding="async" /><figcaption>CONSTRUCTION · HMATIAS RECORD</figcaption></figure></div><div class="brochure-divider"></div><div class="brochure-heading"><p class="brochure-kicker">02 · FACILITIES AND MAINTENANCE</p><h2>Conservation and support<br /><em>for daily operations.</em></h2></div><p class="brochure-description">This area includes preventive or corrective maintenance, professional cleaning, roof conservation and operational support. Frequency, areas, resources, materials and responsibilities are defined before each service begins.</p><div class="brochure-pills"><span>Facility maintenance</span><span>Cleaning and conservation</span><span>Operational support</span><span>Roofing and structures</span></div><a class="brochure-link" href="/en/facilities/">Explore Facilities and Maintenance ↗</a><div class="brochure-page-footer"><span>Interventions and mobilisation are subject to scope and resource assessment.</span><span>03 / 04</span></div></section>
    <section class="brochure-sheet brochure-supply"><div class="brochure-page-head"><Image src={logo} alt="HMATIAS" widths={[100,150]} sizes="98px" format="webp" quality={88} /><span>04 / SUPPLY AND BUSINESS SUPPORT</span></div><div class="brochure-split"><div><p class="brochure-kicker">03 · SUPPLY AND PROCUREMENT</p><h2>Supply shaped<br /><em>with care.</em></h2><p class="brochure-description">HMATIAS provides procurement and supply services on an enquiry basis. Each request is assessed against reference, quantity, application, destination and required timing.</p><ul class="brochure-list"><li>Construction materials and metal profiles</li><li>Industrial consumables and tools</li><li>PPE and professional workwear</li><li>Equipment and lubricants</li></ul><p class="brochure-caution">HMATIAS does not maintain its own stock. Availability, price, documentation and logistics are confirmed for each request.</p><a class="brochure-link" href="/en/supply/">Explore Supply and Procurement ↗</a></div><figure class="brochure-photo"><Picture src={supplyPhoto} alt="Metal profiles for construction applications" widths={[640,960]} sizes="45vw" formats={["avif","webp"]} fallbackFormat="jpg" quality={90} loading="lazy" decoding="async" /><figcaption>CONSTRUCTION MATERIALS</figcaption></figure></div><div class="brochure-divider"></div><div class="brochure-business"><p class="brochure-kicker">04 · BUSINESS SERVICES</p><h2>Administrative, document<br /><em>and business support.</em></h2><p class="brochure-description">Document organisation, institutional correspondence and commercial materials for professionals and small and medium-sized businesses.</p><div class="brochure-pills"><span>Institutional writing and formatting</span><span>Professional CVs</span><span>Document management</span><span>Proposals and quotations</span><span>Business presentations</span><span>Ongoing administrative support</span></div><a class="brochure-link" href="/en/business-services/">Explore Business Services ↗</a></div><div class="brochure-contact"><div><p class="brochure-kicker">COMMERCIAL CONTACT</p><h2>Let's review<br /><em>your requirement.</em></h2></div><div class="brochure-contact-lines"><a href={company.telephoneUri}>{company.phone}</a><a href={"mailto:"+company.commercialEmail}>{company.commercialEmail}</a><a href={"mailto:"+company.institutionalEmail}>{company.institutionalEmail}</a><span>Viana · Luanda · Angola</span><a href="/">HMATIAS website ↗</a></div></div><div class="brochure-page-footer"><span>Scope, deliverables, timing and commercial terms are assessed and confirmed per request.</span><span>04 / 04</span></div></section>
  </main><SiteFooter /><div class="preview-disclaimer">Independent technology preview. It does not replace or modify the official HMATIAS website.</div>
</BaseLayout>
<script>document.querySelector<HTMLButtonElement>("#brochure-print")?.addEventListener("click", () => window.print());</script>
