---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import { company } from "../../../data/site";
---
<BaseLayout title="Accessibility Statement | HMATIAS" description="HMATIAS' ongoing work to improve website accessibility and usability." lang="en">
  <div class="preview-bar"><span><i aria-hidden="true"></i> HMATIAS / ACCESSIBILITY</span><span>ACCESS FOR ALL</span></div>
  <SiteHeader />
  <main class="editorial-page">
    <section class="editorial-hero" aria-labelledby="pages-en-accessibility-index-section-1-heading"><p class="section-kicker">HMATIAS / ACCESSIBILITY</p><h1 id="pages-en-accessibility-index-section-1-heading">A website that is<br /><em>more accessible to everyone.</em></h1><p class="editorial-lead">HMATIAS is working to improve the accessibility and usability of its digital content progressively.</p></section>
    <section class="editorial-body accessibility-body" aria-labelledby="pages-en-accessibility-index-section-2-heading">
      <div class="editorial-label">COMMITMENT AND CURRENT STATUS</div>
      <article class="editorial-feature"><h2 id="pages-en-accessibility-index-section-2-heading">Continuous improvement</h2><p>We are reviewing the website structure, navigation, content and interactive elements to reduce barriers across devices and different ways of browsing.</p><p>This version is under evaluation. An independent audit has not yet been completed, so we do not claim full compliance with a specific accessibility level.</p></article>
      <article class="accessibility-report"><h2>Encountered a problem?</h2><p>Tell us which page is involved, the device or browser you used and the difficulty encountered. Your feedback helps us identify areas that need improvement.</p><a class="button button-dark" href={`mailto:${company.institutionalEmail}?subject=HMATIAS%20website%20accessibility`}>Report an accessibility issue <span aria-hidden="true">↗</span></a></article>
    </section>
  </main>
  <SiteFooter />
  <div class="preview-disclaimer">Independent technology preview. It does not replace or modify the official HMATIAS website.</div>
</BaseLayout>