---
import { Picture } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import { company } from "../../../data/site";

const constructionWhatsapp = company.whatsappUri + "?text=" + encodeURIComponent(
  "Hello HMATIAS. I would like to request an assessment for construction or remodelling. Project location, type of work, dimensions or quantities, target timing, and available photographs or drawings:"
);
import heroPhoto from "../../../../../../images/catalogue/anexo-coberto-estrutura-metalica.webp";
import metalStructure from "../../../../../../images/catalogue/galpao-estrutura-metalica.webp";
import sitePreparation from "../../../../../../images/catalogue/terraplanagem-preparacao-terreno.webp";
import roofWorks from "../../../../../../images/catalogue/cobertura-metalica-substituicao.webp";
import ruralPavilions from "../../../../../../images/catalogue/pavilhoes-rurais-concluidos.webp";
---
<BaseLayout title="Construction and Remodelling in Angola | HMATIAS" description="Civil construction, remodelling, site preparation, paving, roofing and supporting structures for companies and projects in Angola." lang="en">
  <div class="preview-bar"><span><i aria-hidden="true"></i> HMATIAS CONSTRUCTION</span><span>CIVIL CONSTRUCTION · REMODELLING</span></div>
  <SiteHeader />
  <main class="construction-page">
    <section class="construction-hero" id="inicio" aria-labelledby="pages-en-construction-index-section-1-heading">
      <div class="construction-hero-copy">
        <nav class="construction-breadcrumb" aria-label="Breadcrumb"><a href="/en/">Home</a><span>/</span><span>Construction and Remodelling</span></nav>
        <p class="eyebrow"><span class="eyebrow-line"></span> CIVIL CONSTRUCTION · REMODELLING</p>
        <h1 id="pages-en-construction-index-section-1-heading">Construction and<br /><em>remodelling.</em></h1>
        <p class="hero-lead">Building works, rehabilitation and interventions in existing facilities and infrastructure for companies and projects in Angola.</p>
        <div class="hero-actions"><a class="button button-light" href="#request">Discuss a project <span aria-hidden="true">↓</span></a><a class="text-link text-link-light" href="#work">View visual references <span aria-hidden="true">↘</span></a></div>
        <div class="hero-meta"><span>Construction · Remodelling · Paving</span><span>Luanda · Angola</span></div>
      </div>
      <figure class="construction-hero-image"><Picture src={heroPhoto} alt="Covered annex with a metal structure attached to an existing building" widths={[640,960,1280]} sizes="(max-width:900px) 100vw, 48vw" formats={["avif", "webp"]} fallbackFormat="jpg" quality={84} loading="eager" fetchpriority="high" decoding="async" /><figcaption><span>01</span> METAL STRUCTURE · COVERED ANNEX</figcaption></figure>
      <span class="construction-hero-note" aria-hidden="true">BUILDING WORKS · REHABILITATION · INFRASTRUCTURE</span>
    </section>

    <section class="construction-intro section-pad" id="company" aria-labelledby="pages-en-construction-index-section-2-heading">
      <div class="section-kicker">01 / SERVICE AREA</div>
      <div class="construction-intro-content">
        <h2 id="pages-en-construction-index-section-2-heading">Interventions planned<br /><em>for the space and its use.</em></h2>
        <div class="construction-intro-copy">
          <p>The Construction and Remodelling service area covers civil construction and remodelling, including work in existing premises, site preparation, paving, roofing and supporting structures.</p>
          
          <a class="underlined-link" href="#work">Review visual references <span aria-hidden="true">↘</span></a>
        </div>
      </div>
    </section>

    <section class="construction-scopes section-pad" id="services" aria-labelledby="pages-en-construction-index-section-3-heading">
      <div class="section-heading"><div><div class="section-kicker">02 / SCOPE OF WORK</div><h2 id="pages-en-construction-index-section-3-heading">From construction<br /><em>to rehabilitation.</em></h2></div><p>Each intervention is assessed according to the type of work, existing conditions and intended outcome.</p></div>
      <div class="construction-scope-grid">
        <article class="construction-scope-card"><span>01</span><h3>Civil construction</h3><p>Building works for business premises, facilities and project requirements.</p></article>
        <article class="construction-scope-card" id="remodelling"><span>02</span><h3>Remodelling and rehabilitation</h3><p>Upgrading existing spaces, including offices, washrooms and supporting areas.</p></article>
        <article class="construction-scope-card"><span>03</span><h3>Site preparation and paving</h3><p>Ground preparation, earthmoving, surface levelling and paving works.</p></article>
        <article class="construction-scope-card"><span>04</span><h3>Roofing and metal structures</h3><p>Roof coverings, metal structures and supporting construction elements.</p></article>
      </div>
      <div class="specialist-inline-links">
        <a href="/en/industrial-roofing/">Industrial roofing assessment and maintenance ↗</a>
        <a href="/en/office-remodelling/">Office remodelling ↗</a>
      </div>
    </section>

    <section class="construction-work section-pad" id="work" aria-labelledby="pages-en-construction-index-section-4-heading">
      <div class="section-heading"><div><div class="section-kicker">03 / VISUAL REFERENCES</div><h2 id="pages-en-construction-index-section-4-heading">Construction elements<br /><em>and visible stages.</em></h2></div><p>The photographs show visible construction elements and stages in the visual archive, including metal structures, site preparation and roof sheets. They are not attributed to specific contracts or clients.</p></div>
      <div class="construction-work-grid">
        <article class="construction-work-card"><figure><Picture src={metalStructure} alt="Metal structure, sheet roof covering and supporting masonry" widths={[640,960]} sizes="(max-width:650px) 100vw, 50vw" formats={["avif", "webp"]} fallbackFormat="jpg" quality={82} decoding="async" loading="lazy" /></figure><div class="construction-work-caption"><span>METAL STRUCTURES</span><h3>Metal-frame building</h3><p>Metal structure, roof covering and supporting masonry visible during an execution stage.</p></div></article>
        <article class="construction-work-card"><figure><Picture src={sitePreparation} alt="Earthmoving equipment on natural ground, with excavated and levelled material visible" widths={[640,960]} sizes="(max-width:650px) 100vw, 50vw" formats={["avif", "webp"]} fallbackFormat="jpg" quality={82} decoding="async" loading="lazy" /></figure><div class="construction-work-caption"><span>INFRASTRUCTURE</span><h3>Site preparation</h3><p>Earthmoving equipment on natural ground, with excavated and levelled material visible.</p></div></article>
        <article class="construction-work-card"><figure><Picture src={roofWorks} alt="New profiled sheets beside existing sheets on a roof under intervention" widths={[640,960]} sizes="(max-width:650px) 100vw, 50vw" formats={["avif", "webp"]} fallbackFormat="jpg" quality={82} decoding="async" loading="lazy" /></figure><div class="construction-work-caption"><span>MAINTENANCE</span><h3>Profiled roof sheets</h3><p>New profiled sheets positioned beside existing sheets on a roof under intervention.</p></div></article>
        <article class="construction-work-card"><figure><Picture src={ruralPavilions} alt="Two elongated pavilions with metal roofing and partially open sides" widths={[640,960]} sizes="(max-width:650px) 100vw, 50vw" formats={["avif", "webp"]} fallbackFormat="jpg" quality={82} decoding="async" loading="lazy" /></figure><div class="construction-work-caption"><span>RURAL CONSTRUCTION</span><h3>Rural pavilions with metal roofing</h3><p>Two elongated pavilions with metal roofing and partially open sides.</p></div></article>
      </div>
      <p class="construction-record-link"><a class="underlined-link" href="/en/works-catalogue/#private-project-luanda">View the foundations and masonry record for Luanda ↗</a></p>
    </section>



    <section class="construction-request section-pad" id="request" aria-labelledby="pages-en-construction-index-section-5-heading">
      <div class="construction-request-copy"><p class="section-kicker">04 / PROJECT ENQUIRIES</p><h2 id="pages-en-construction-index-section-5-heading">Let's review<br /><em>your project.</em></h2><p>Send the location, a description of the work and any available drawings or specifications. HMATIAS will review the requirement and indicate the information needed for an initial assessment.</p><div class="construction-request-actions"><a class="button button-light" href={constructionWhatsapp} target="_blank" rel="noopener noreferrer">Contact via WhatsApp <span aria-hidden="true">↗</span></a><a class="construction-email-link" href={`mailto:${company.commercialEmail}?subject=Construction%20project%20enquiry`}>Send project details by email <span>↗</span></a></div></div>
      <aside class="construction-request-guide"><h3>Information to include</h3><ul><li>Project location</li><li>Type of work required</li><li>Approximate dimensions or quantities</li><li>Drawings, photographs or technical requirements</li><li>Target schedule</li></ul><p>Project feasibility, scope and delivery conditions are subject to review.</p></aside>
    </section>
  </main>
  <SiteFooter />
  <div class="preview-disclaimer">Independent technology preview. It does not replace or modify the official HMATIAS website.</div>
  <style>.construction-record-link{margin:22px 0 0}.construction-record-link a{font-size:11px}</style>
</BaseLayout>