---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft && data.language === "en"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = posts[0];
const featuredDate = featured?.data.pubDate.toLocaleDateString("en", { day:"2-digit", month:"long", year:"numeric" });
---
<BaseLayout title="HMATIAS Blog | Practical Sourcing Guides" description="Practical HMATIAS guides for preparing quotation requests, specifying materials and comparing supply proposals in Angola." lang="en">
  <div class="preview-bar"><span><i aria-hidden="true"></i> HMATIAS PUBLICATIONS</span><span>QUOTATIONS · SPECIFICATIONS · SUPPLY</span></div>
  <SiteHeader />
  <main class="editorial-page">
    <section class="editorial-hero" aria-labelledby="pages-en-blog-index-section-1-heading">
      <p class="section-kicker">HMATIAS / BLOG</p>
      <h1 id="pages-en-blog-index-section-1-heading">Practical guides for<br /><em>sourcing and supply.</em></h1>
      <p class="editorial-lead">Technical and commercial notes on preparing quotation requests, specifying materials and comparing supplier proposals.</p>
    </section>
    <section class="editorial-body" aria-labelledby="pages-en-blog-index-section-2-heading">
      {featured ? (
        <>
          <div class="editorial-label">FEATURED ARTICLE · {featuredDate?.toUpperCase()}</div>
          <article class="editorial-feature">
            <p class="editorial-meta">{featured.data.category.toUpperCase()} · {featured.data.author.toUpperCase()}</p>
            <h2 id="pages-en-blog-index-section-2-heading"><a href={`/en/blog/${featured.id}/`}>{featured.data.title}</a></h2>
            <p>{featured.data.description}</p>
            <a class="editorial-read-link" href={`/en/blog/${featured.id}/`}>Read the article <span aria-hidden="true">↗</span></a>
          </article>
        </>
      ) : <p class="editorial-empty">There are no articles published in this language yet.</p>}

      <div class="editorial-contact">
        <p>For commercial enquiries or quotation requests, contact HMATIAS directly.</p>
        <a class="button button-dark" href="/en/source-ao/smart-rfq/">Prepare a Smart RFQ <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
  <SiteFooter />
  <div class="preview-disclaimer">Independent technology preview. It does not replace or modify the official HMATIAS website.</div>
</BaseLayout>