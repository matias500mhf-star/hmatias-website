---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft && data.language === "en"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = posts[0];
const featuredDate = featured?.data.pubDate.toLocaleDateString("en", { day:"2-digit", month:"long", year:"numeric" });
---
<BaseLayout title="HMATIAS Blog | Business Insights" description="Practical guides and perspectives from HMATIAS on construction, procurement, supply, facilities and business activity in Angola." lang="en">
  <div class="preview-bar"><span><i aria-hidden="true"></i> HMATIAS PUBLICATIONS</span><span>INSIGHTS · ANALYSIS · MARKET</span></div>
  <SiteHeader />
  <main class="editorial-page">
    <section class="editorial-hero">
      <p class="section-kicker">HMATIAS / BLOG</p>
      <h1>Business insights<br /><em>for better decisions.</em></h1>
      <p class="editorial-lead">Practical guides and perspectives on construction, procurement, supply, facilities and business activity in Angola.</p>
    </section>
    <section class="editorial-body">
      {featured ? (
        <>
          <div class="editorial-label">FEATURED ARTICLE · {featuredDate?.toUpperCase()}</div>
          <article class="editorial-feature">
            <p class="editorial-meta">{featured.data.category.toUpperCase()} · {featured.data.author.toUpperCase()}</p>
            <h2><a href={`/en/blog/${featured.id}/`}>{featured.data.title}</a></h2>
            <p>{featured.data.description}</p>
            <a class="editorial-read-link" href={`/en/blog/${featured.id}/`}>Read the article <span aria-hidden="true">↗</span></a>
          </article>
        </>
      ) : <p class="editorial-empty">There are no articles published in this language yet.</p>}
      <div class="editorial-topics">
        <h2>Editorial topics</h2>
        <div class="editorial-topic-grid">
          <div><span>01</span><strong>Construction and Engineering</strong></div>
          <div><span>02</span><strong>Procurement and Supply</strong></div>
          <div><span>03</span><strong>Facilities and Maintenance</strong></div>
          <div><span>04</span><strong>Business Market</strong></div>
        </div>
      </div>
      <div class="editorial-contact">
        <p>For commercial enquiries or quotation requests, contact HMATIAS directly.</p>
        <a class="button button-dark" href="/en/source-ao/smart-rfq/">Prepare a Smart RFQ <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
  <SiteFooter />
  <div class="preview-disclaimer">Independent technology preview. It does not replace or modify the official HMATIAS website.</div>
</BaseLayout>