---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SourceAoRfqForm from "../../../components/SourceAoRfqForm.astro";

const candidateApiBase = String(import.meta.env.PUBLIC_SOURCE_AO_API_BASE ?? "").trim();
let sourceAoApiBase = "";
try {
  const parsed = new URL(candidateApiBase);
  if (parsed.protocol === "https:" && parsed.hostname.toLowerCase().includes("staging")) {
    sourceAoApiBase = parsed.origin;
  }
} catch {
  sourceAoApiBase = "";
}
---
<BaseLayout
  title="Pedido de Sourcing | SOURCE AO"
  description="Registe um pedido de sourcing multiartigo, com especificações, quantidades, destino e prazo. A HMATIAS valida as opções de fornecimento antes de apresentar uma proposta."
>
  <div class="source-rfq-preview-bar">
    <a href="/source-ao/" aria-label="Voltar ao SOURCE AO">SOURCE AO</a>
    <span>PEDIDO DE SOURCING · HMATIAS</span>
  </div>
  {!sourceAoApiBase && <p class="source-rfq-stage-note" role="status">Pré-visualização isolada: o registo online só será activado quando a API de staging estiver configurada. Esta página não envia pedidos para a base de dados de produção.</p>}
  <SourceAoRfqForm apiBase={sourceAoApiBase} />
</BaseLayout>
<style>
.source-rfq-preview-bar{display:flex;justify-content:space-between;align-items:center;gap:18px;padding:12px clamp(16px,5vw,72px);background:#061827;color:#c8d7e4;font-size:10px;font-weight:750;letter-spacing:.13em}
.source-rfq-preview-bar a{color:#fff;text-decoration:none}
.source-rfq-stage-note{margin:0;padding:12px clamp(16px,5vw,72px);background:#fff7e8;border-bottom:1px solid #ead8b8;color:#654a1d;font-size:12px;line-height:1.6}
@media(max-width:520px){.source-rfq-preview-bar{align-items:flex-start;flex-direction:column;gap:5px}}
</style>
