---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { company } from "../../data/site";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft && data.language === "pt-AO"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = posts[0];
const featuredDate = featured?.data.pubDate.toLocaleDateString("pt-AO", {
  day: "2-digit",
  month: "long",
  year: "numeric",
});
---
<BaseLayout
  title="Blog HMATIAS | Perspetivas empresariais"
  description="Análises e guias práticos da HMATIAS sobre construção, procurement, fornecimento, facilities e mercado empresarial em Angola."
>
  <div class="preview-bar">
    <span><i aria-hidden="true"></i> PUBLICAÇÕES HMATIAS</span>
    <span>Conhecimento · Análise · Mercado</span>
  </div>
  <SiteHeader />
  <main class="editorial-page">
    <section class="editorial-hero">
      <p class="section-kicker">HMATIAS / BLOG</p>
      <h1>Perspetivas empresariais<br /><em>para decisões melhores.</em></h1>
      <p class="editorial-lead">Análises e guias práticos sobre construção, procurement, fornecimento, facilities e atividade empresarial em Angola.</p>
    </section>

    <section class="editorial-body">
      {featured ? (
        <>
          <div class="editorial-label">ARTIGO EM DESTAQUE · {featuredDate?.toUpperCase()}</div>
          <article class="editorial-feature">
            <p class="editorial-meta">{featured.data.category.toUpperCase()} · {featured.data.author.toUpperCase()}</p>
            <h2><a href={`/blog/${featured.id}/`}>{featured.data.title}</a></h2>
            <p>{featured.data.description}</p>
            <a class="editorial-read-link" href={`/blog/${featured.id}/`}>Ler o artigo <span aria-hidden="true">↗</span></a>
          </article>
        </>
      ) : (
        <p class="editorial-empty">Não existem artigos publicados nesta língua.</p>
      )}

      <div class="editorial-topics">
        <h2>Temas editoriais</h2>
        <div class="editorial-topic-grid">
          <div><span>01</span><strong>Construção e Engenharia</strong></div>
          <div><span>02</span><strong>Procurement e Supply</strong></div>
          <div><span>03</span><strong>Facilities e Manutenção</strong></div>
          <div><span>04</span><strong>Mercado Empresarial</strong></div>
        </div>
      </div>

      <div class="editorial-contact">
        <p>Para assuntos comerciais ou pedidos de cotação, contacte diretamente a HMATIAS.</p>
        <a class="button button-dark" href={company.smartRfqUrl}>Preparar Smart RFQ <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
  <SiteFooter />
  <div class="preview-disclaimer">Protótipo tecnológico independente. Não substitui nem modifica o website oficial da HMATIAS.</div>
</BaseLayout>
