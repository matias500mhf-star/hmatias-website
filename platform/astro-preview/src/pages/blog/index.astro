---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { company } from "../../data/site";
import { getCollection } from "astro:content";
const posts = (await getCollection("blog", ({ data }) => !data.draft && data.language === "pt-AO")).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const featured = posts[0];
const featuredDate = featured?.data.pubDate.toLocaleDateString("pt-AO",{day:"2-digit",month:"long",year:"numeric"});
const categories = [...new Set(posts.map((post)=>post.data.category))];
const categoryGroups = categories.map((category)=>({name:category,id:"categoria-"+category.normalize("NFD").replace(/[\u0300-\u036f]/g,"").toLowerCase().replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,""),items:posts.filter((post)=>post.data.category===category&&post.id!==featured?.id)})).filter((group)=>group.items.length>0);
---
<BaseLayout title="Blog HMATIAS | Perspetivas empresariais e guias práticos" description="Guias técnicos, notas de procurement e casos práticos ilustrativos sobre construção, manutenção, fornecimento e gestão operacional em Angola.">
  <div class="preview-bar"><span><i aria-hidden="true"></i> PUBLICAÇÕES HMATIAS</span><span>OBRAS · PROCUREMENT · OPERAÇÕES</span></div>
  <SiteHeader />
  <main class="editorial-page">
    <section class="editorial-hero" aria-labelledby="pages-blog-index-section-1-heading">
      <p class="section-kicker">HMATIAS / BLOG</p>
      <h1 id="pages-blog-index-section-1-heading">Perspetivas empresariais.<br /><em>Conhecimento aplicável.</em></h1>
      <p class="editorial-lead">Conteúdo técnico e comercial para apoiar decisões, preparar intervenções, estruturar fornecimentos e melhorar a gestão de operações.</p>
    </section>
    <section class="editorial-body" aria-label="Artigos e temas">
      {featured && <>
        <div class="editorial-label">EM DESTAQUE · {featuredDate?.toUpperCase()}</div>
        <article class="editorial-feature">
          <p class="editorial-meta">{featured.data.contentType==="case-study"?"CASO PRÁTICO ILUSTRATIVO":"GUIA TÉCNICO"} · {featured.data.category.toUpperCase()} · {featured.data.readingMinutes} MIN DE LEITURA</p>
          <h2><a href={"/blog/"+featured.id+"/"}>{featured.data.title}</a></h2>
          <p>{featured.data.description}</p>
          <a class="editorial-read-link" href={"/blog/"+featured.id+"/"}>Ler o artigo <span aria-hidden="true">↗</span></a>
        </article>
      </>}
      {categoryGroups.length>0 && <nav class="editorial-category-nav" aria-label="Navegar por temas">
        {categoryGroups.map((group)=><a href={"#"+group.id}>{group.name} <span>({group.items.length})</span></a>)}
      </nav>}
      <div class="editorial-archive">
        {categoryGroups.map((group)=><section class="editorial-category" id={group.id} aria-labelledby={group.id+"-heading"}>
          <div class="editorial-category-heading"><h2 id={group.id+"-heading"}>{group.name}</h2><span>{group.items.length} ARTIGO(S)</span></div>
          <div class="editorial-card-grid">
            {group.items.map((post)=><article class="editorial-card">
              <p class="editorial-card-type">{post.data.contentType==="case-study"?"Caso prático ilustrativo":"Guia técnico"}</p>
              <h3><a href={"/blog/"+post.id+"/"}>{post.data.title}</a></h3>
              <p class="editorial-card-description">{post.data.description}</p>
              <div class="editorial-card-meta"><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString("pt-AO",{day:"2-digit",month:"short",year:"numeric"})}</time><span>{post.data.readingMinutes} min de leitura</span></div>
              <a class="editorial-card-link" href={"/blog/"+post.id+"/"}>Abrir artigo <span aria-hidden="true">↗</span></a>
            </article>)}
          </div>
        </section>)}
      </div>
      <p class="editorial-archive-note">Os casos práticos identificados como ilustrativos explicam métodos e critérios de decisão. Não representam obras, clientes ou resultados comerciais atribuídos à HMATIAS.</p>
      <div class="editorial-contact"><p>Para uma necessidade concreta de fornecimento, especifique os artigos, quantidades e local de entrega no SOURCE AO.</p><a class="button button-dark" href={company.smartRfqUrl}>Preparar Smart RFQ <span aria-hidden="true">↗</span></a></div>
    </section>
  </main>
  <SiteFooter />
  <div class="preview-disclaimer">Protótipo tecnológico independente. Não substitui nem modifica o website oficial da HMATIAS.</div>
</BaseLayout>