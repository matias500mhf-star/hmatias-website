---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { company } from "../../data/site";
import roofMaintenance from "../../../../../images/catalogue/cobertura-metalica-substituicao.webp";
import metalHall from "../../../../../images/catalogue/galpao-estrutura-metalica.webp";
import ruralPavilions from "../../../../../images/catalogue/pavilhoes-rurais-concluidos.webp";
import sitePreparation from "../../../../../images/catalogue/terraplanagem-preparacao-terreno.webp";
import masonry from "../../../../../images/catalogue/alvenaria-elementos-estruturais.webp";
import waterTank from "../../../../../images/catalogue/reservatorio-compartimentado-betao.webp";
import coveredAnnex from "../../../../../images/catalogue/anexo-coberto-estrutura-metalica.webp";
import aluminiumGlass from "../../../../../images/catalogue/caixilharia-vidro-fumado.webp";
import metalProfiles from "../../../../../images/catalogue/perfis-metalicos-estrutura.webp";
import roofSheets from "../../../../../images/catalogue/chapas-cobertura-fornecimento.webp";
import logistics from "../../../../../images/catalogue/logistica-estrutura-metalica.webp";
import embeddedServices from "../../../../../images/catalogue/instalacoes-embutidas-construcao.webp";

const works = [
  {category:"Coberturas · Manutenção",title:"Substituição de Cobertura Metálica",description:"Substituição localizada de chapas de cobertura, com fixação mecânica e integração com a cobertura existente.",image:roofMaintenance,alt:"Substituição parcial de cobertura metálica com novas chapas perfiladas"},
  {category:"Estruturas Metálicas",title:"Galpão com Estrutura Metálica",description:"Montagem de estrutura metálica, cobertura e fechamentos em chapa, com alvenaria de apoio.",image:metalHall,alt:"Galpão em construção com estrutura metálica e cobertura em chapa"},
  {category:"Construção Rural · Infraestrutura",title:"Pavilhões Rurais Concluídos",description:"Vista exterior de pavilhões concluídos, com cobertura metálica e áreas laterais ventiladas.",image:ruralPavilions,alt:"Pavilhões rurais concluídos com cobertura metálica vermelha"},
  {category:"Terraplanagem",title:"Preparação de Terreno",description:"Mobilização de retroescavadora para movimentação de terras e regularização inicial do terreno.",image:sitePreparation,alt:"Retroescavadora em preparação e regularização de terreno"},
  {category:"Alvenaria · Execução",title:"Alvenaria, Vãos & Reforços",description:"Execução de paredes em bloco de betão, definição de vãos, vergas e reforços verticais.",image:masonry,alt:"Execução de alvenaria com vergas e armaduras verticais"},
  {category:"Obras Hidráulicas · Betão",title:"Reservatório Compartimentado",description:"Estrutura compartimentada em betão, com divisórias internas e acabamento cimentício para apoio hidráulico.",image:waterTank,alt:"Reservatório compartimentado em betão com divisórias internas"},
  {category:"Obras Complementares",title:"Anexo Coberto com Estrutura Metálica",description:"Estrutura metálica de cobertura para criação de área complementar junto à edificação existente.",image:coveredAnnex,alt:"Anexo coberto com estrutura metálica e telha cerâmica"},
  {category:"Caixilharia · Fechamentos",title:"Alumínio & Vidro Fumado",description:"Fechamento em perfis de alumínio e painéis de vidro fumado, incluindo portas de correr.",image:aluminiumGlass,alt:"Fechamento em caixilharia de alumínio e vidro fumado"},
  {category:"Estruturas · Materiais",title:"Perfis Metálicos para Estruturas",description:"Perfis metálicos preparados e organizados em obra para posterior montagem estrutural.",image:metalProfiles,alt:"Perfis metálicos organizados em obra para montagem estrutural"},
  {category:"Supply · Coberturas",title:"Chapas Perfiladas para Cobertura",description:"Chapas metálicas perfiladas prontas para fornecimento e aplicação em sistemas de cobertura.",image:roofSheets,alt:"Chapas metálicas perfiladas para aplicação em cobertura"},
  {category:"Logística · Estruturas",title:"Mobilização de Estrutura Metálica",description:"Transporte e mobilização de elementos metálicos destinados à execução e montagem em obra.",image:logistics,alt:"Transporte de elementos metálicos em camião para execução de obra"},
  {category:"Construção · Instalações",title:"Instalações Embutidas em Construção",description:"Fase de construção com paredes em bloco e preparação de pontos elétricos e hidráulicos embutidos.",image:embeddedServices,alt:"Interior de construção com alvenaria e pontos técnicos embutidos"}
];
---
<BaseLayout title="Catálogo de Obras, Intervenções e Fornecimentos | HMATIAS" description="Registos fotográficos de obras, intervenções, fases de execução, materiais e fornecimentos da HMATIAS em Angola.">
  <div class="preview-bar"><span><i aria-hidden="true"></i> ARQUIVO VISUAL HMATIAS</span><span>Obras · Intervenções · Fornecimentos</span></div>
  <SiteHeader />
  <main class="works-catalogue">
    <section class="works-catalogue-hero">
      <div class="works-catalogue-hero-inner">
        <p class="eyebrow"><span class="eyebrow-line"></span> ARQUIVO VISUAL HMATIAS</p>
        <h1>Obras, intervenções<br /><em>e fornecimentos.</em></h1>
        <p>Seleção de registos fotográficos de obras, intervenções, fases de execução e referências de fornecimento da HMATIAS. O catálogo mostra o tipo de trabalho ou material de forma direta; clientes e localizações são identificados apenas quando a divulgação é adequada ou autorizada.</p>
        <div class="hero-actions">
          <a class="button button-light" href={company.legacyContactFormUrl}>Solicitar avaliação <span aria-hidden="true">↗</span></a>
          <a class="text-link text-link-light" href={company.constructionUrl}>Construção &amp; Infraestrutura <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
    <section class="works-catalogue-body section-pad">
      <div class="section-heading">
        <div><div class="section-kicker">01 / REGISTOS FOTOGRÁFICOS</div><h2>Construção, infraestrutura,<br /><em>manutenção e fornecimento.</em></h2></div>
      </div>
      <div class="works-catalogue-grid">
        {works.map((work,index) => (
          <article class="works-catalogue-card">
            <figure><Image src={work.image} alt={work.alt} widths={[480,720,1040]} sizes="(max-width:650px) 100vw, (max-width:1000px) 50vw, 33vw" format="webp" quality={82} /></figure>
            <div class="works-catalogue-copy"><span>{String(index+1).padStart(2,"0")} · {work.category}</span><h3>{work.title}</h3><p>{work.description}</p></div>
          </article>
        ))}
      </div>
      <p class="works-catalogue-note">Este catálogo é um arquivo visual comercial e não substitui contratos, autos de medição, faturas ou outros documentos de comprovação. A HMATIAS identifica clientes, datas e localizações apenas quando essa divulgação é adequada ou autorizada.</p>
    </section>
    <section class="works-catalogue-cta">
      <div><p class="section-kicker">TEM UMA OBRA OU INTERVENÇÃO?</p><h2>Apresente o seu projeto<br /><em>à HMATIAS.</em></h2><p>Envie localização, fotografias, medidas aproximadas e uma descrição breve para estruturarmos o próximo passo.</p></div>
      <a class="button button-light" href={company.legacyContactFormUrl}>Solicitar avaliação <span aria-hidden="true">↗</span></a>
    </section>
  </main>
  <SiteFooter />
  <div class="preview-disclaimer">Protótipo tecnológico independente. Não substitui nem modifica o website oficial da HMATIAS.</div>
</BaseLayout>
<style>
.works-catalogue-hero { padding:clamp(70px,9vw,115px) var(--hm-gutter); color:#fff; background:var(--hm-navy); }
.works-catalogue-hero-inner { max-width:900px; }
.works-catalogue-hero h1 { margin:0; font-size:clamp(44px,6vw,82px); font-weight:520; line-height:1.02; letter-spacing:-.065em; }
.works-catalogue-hero h1 em { color:#b9d8ed; font-family:var(--hm-serif); font-weight:400; }
.works-catalogue-hero > div > p:not(.eyebrow) { max-width:680px; margin:26px 0 0; color:#dceafa; font-size:13px; line-height:1.85; }
.works-catalogue-hero .hero-actions { margin-top:32px; }
.works-catalogue-body { background:var(--hm-paper); }
.works-catalogue-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); align-items:start; gap:35px 22px; margin-top:55px; }
.works-catalogue-card { min-width:0; }
.works-catalogue-card figure { margin:0; background:var(--hm-light); }
.works-catalogue-card figure img { display:block; width:100%; height:auto; object-fit:contain; }
.works-catalogue-copy { padding:16px 2px 0; }
.works-catalogue-copy > span { color:var(--hm-blue); font-size:9px; font-weight:700; letter-spacing:.09em; text-transform:uppercase; }
.works-catalogue-copy h3 { margin:10px 0 8px; color:var(--hm-ink); font-size:16px; line-height:1.35; font-weight:650; letter-spacing:-.025em; }
.works-catalogue-copy p { margin:0; color:var(--hm-muted); font-size:11px; line-height:1.8; }
.works-catalogue-note { max-width:900px; margin:44px auto 0; padding:19px 22px; color:var(--hm-muted); background:var(--hm-light); border-left:2px solid var(--hm-blue); font-size:10px; line-height:1.8; }
.works-catalogue-cta { padding:clamp(60px,8vw,95px) var(--hm-gutter); display:flex; justify-content:space-between; align-items:center; gap:35px; color:#fff; background:var(--hm-navy); }
.works-catalogue-cta .section-kicker { margin:0 0 18px; padding:0; color:#b9d8ed; }
.works-catalogue-cta h2 { margin:0; font-size:clamp(35px,4.5vw,58px); line-height:1.07; letter-spacing:-.06em; font-weight:520; }
.works-catalogue-cta h2 em { color:#b9d8ed; font-family:var(--hm-serif); font-weight:400; }
.works-catalogue-cta > div > p:not(.section-kicker) { max-width:560px; margin:16px 0 0; color:#dceafa; font-size:11px; line-height:1.8; }
@media(max-width:950px) { .works-catalogue-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
@media(max-width:650px) { .works-catalogue-grid { grid-template-columns:1fr; gap:28px; margin-top:35px; } .works-catalogue-cta { flex-direction:column; align-items:flex-start; } }
</style>
