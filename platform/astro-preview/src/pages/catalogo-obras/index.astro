---
import { Image, Picture } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { company } from "../../data/site";
import roofMaintenance from "../../../../../images/catalogue/cobertura-metalica-substituicao.webp";
import metalHall from "../../../../../images/catalogue/galpao-estrutura-metalica.webp";
import ruralPavilions from "../../../../../images/catalogue/pavilhoes-rurais-concluidos.webp";
import sitePreparation from "../../../../../images/catalogue/terraplanagem-preparacao-terreno.webp";
import masonry from "../../../../../images/catalogue/alvenaria-elementos-estruturais.webp";
import waterTank from "../../../../../images/catalogue/reservatorio-compartimentado-betao.webp";
import coveredAnnex from "../../../../../images/catalogue/anexo-coberto-estrutura-metalica.webp";
import aluminiumGlass from "../../../../../images/catalogue/caixilharia-vidro-fumado.webp";
import metalProfiles from "../../../../../images/catalogue/perfis-metalicos-estrutura.webp";
import roofSheets from "../../../../../images/catalogue/chapas-cobertura-fornecimento.webp";
import logistics from "../../../../../images/catalogue/logistica-estrutura-metalica.webp";
import embeddedServices from "../../../../../images/catalogue/instalacoes-embutidas-construcao.webp";
import luandaOverview from "../../../../../images/catalogue/obra-privada-luanda-alvenaria-vista-geral.avif";
import luandaFormwork from "../../../../../images/catalogue/obra-privada-luanda-cofragem-armadura-fundacao.avif";
import luandaMasonry from "../../../../../images/catalogue/obra-privada-luanda-detalhe-alvenaria.avif";

const works = [
  {category:"Coberturas · Manutenção",title:"Intervenção em cobertura metálica",description:"Registo de chapas perfiladas novas colocadas junto às chapas existentes, documentando uma fase de substituição localizada.",image:roofMaintenance,alt:"Chapas metálicas perfiladas novas e existentes numa cobertura em intervenção"},
  {category:"Estruturas Metálicas",title:"Galpão com estrutura metálica",description:"Estrutura metálica e cobertura em execução, com fechamentos em chapa e alvenaria de apoio visíveis no registo.",image:metalHall,alt:"Galpão com estrutura metálica, cobertura e fechamentos em chapa"},
  {category:"Construção Rural · Infraestrutura",title:"Pavilhões com cobertura metálica",description:"Vista exterior de dois pavilhões alongados, com cobertura metálica e laterais parcialmente abertas para ventilação.",image:ruralPavilions,alt:"Dois pavilhões rurais com cobertura metálica vermelha e laterais ventiladas"},
  {category:"Terraplanagem",title:"Movimentação e preparação de terreno",description:"Equipamento de movimentação de terras numa área de solo natural, com marcas de circulação e acumulação de material escavado.",image:sitePreparation,alt:"Equipamento de movimentação de terras em terreno de solo vermelho"},
  {category:"Alvenaria · Execução",title:"Alvenaria e execução de vãos",description:"Paredes em blocos de betão com vãos de acesso e elementos de betão aparente na composição da edificação.",image:masonry,alt:"Paredes em blocos de betão com vãos e elementos de betão aparente"},
  {category:"Obras Hidráulicas · Betão",title:"Reservatório em betão com divisórias",description:"Estrutura em betão com compartimentos internos visíveis e superfícies interiores revestidas.",image:waterTank,alt:"Reservatório em betão com vários compartimentos internos"},
  {category:"Obras Complementares",title:"Anexo com cobertura apoiada em estrutura metálica",description:"Área coberta junto a uma edificação existente, com estrutura metálica aparente e cobertura em telha cerâmica.",image:coveredAnnex,alt:"Anexo coberto junto a uma edificação com estrutura metálica e telha cerâmica"},
  {category:"Caixilharia · Fechamentos",title:"Caixilharia de alumínio e vidro fumado",description:"Conjunto de vãos com perfis de alumínio, painéis de vidro fumado e porta central de correr.",image:aluminiumGlass,alt:"Vãos com caixilharia de alumínio e painéis de vidro fumado"},
  {group:"supply",category:"Supply · Estruturas",title:"Perfis metálicos",description:"Perfis metálicos organizados junto a uma frente de alvenaria. O registo documenta o material armazenado em obra, não o seu dimensionamento.",image:metalProfiles,alt:"Perfis metálicos organizados junto a uma parede de alvenaria"},
  {group:"supply",category:"Supply · Coberturas",title:"Chapas perfiladas para cobertura",description:"Chapas metálicas perfiladas organizadas em pilhas, apresentadas como referência visual de material para cobertura.",image:roofSheets,alt:"Chapas metálicas perfiladas organizadas em pilhas"},
  {group:"supply",category:"Logística · Estruturas",title:"Transporte de elementos metálicos",description:"Elementos metálicos transportados numa viatura de carga, documentando uma operação de logística de materiais.",image:logistics,alt:"Viatura de carga com elementos metálicos para transporte"},
  {category:"Construção · Instalações",title:"Infraestruturas técnicas em fase de obra",description:"Interior de uma edificação em construção, com paredes em bloco, tubagens e caixas técnicas visíveis.",image:embeddedServices,alt:"Interior em construção com alvenaria, tubagens e caixas técnicas"}
];
---
<BaseLayout title="Catálogo de Obras, Intervenções e Fornecimentos | HMATIAS" description="Catálogo visual HMATIAS com fotografias de elementos de construção, fases de execução, materiais e referências de fornecimento em Angola. As legendas descrevem o que é visível; a associação a uma obra ou cliente é apresentada apenas quando confirmada e autorizada.">
  <div class="preview-bar"><span><i aria-hidden="true"></i> ARQUIVO VISUAL HMATIAS</span><span>Obras · Intervenções · Fornecimentos</span></div>
  <SiteHeader />
  <main class="works-catalogue">
    <section class="works-catalogue-hero" aria-labelledby="pages-catalogo-obras-index-section-1-heading">
      <div class="works-catalogue-hero-inner">
        <p class="eyebrow"><span class="eyebrow-line"></span> ARQUIVO VISUAL HMATIAS</p>
        <h1 id="pages-catalogo-obras-index-section-1-heading">Obras, intervenções<br /><em>e fornecimentos.</em></h1>
        <p>Seleção de fotografias de elementos construtivos, fases de execução e referências de fornecimento. O catálogo descreve o que cada imagem permite observar; a associação a obras, clientes e localizações é apresentada apenas quando confirmada e autorizada.</p>
        <div class="hero-actions">
          <a class="button button-light" href={company.contactFormUrl} target="_blank" rel="noopener noreferrer">Solicitar avaliação <span aria-hidden="true">↗</span></a>
          <a class="text-link text-link-light" href={company.constructionUrl}>Construção &amp; Infraestrutura <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
    <section class="works-catalogue-featured section-pad" id="obra-privada-luanda" aria-labelledby="obra-privada-luanda-heading">
      <div class="works-catalogue-featured-heading">
        <div>
          <p class="section-kicker">01 / OBRA DOCUMENTADA</p>
          <h2 id="obra-privada-luanda-heading">Fundações e alvenaria<br /><em>obra privada · Luanda.</em></h2>
        </div>
        <dl class="works-catalogue-project-meta">
          <div><dt>Localização</dt><dd>Luanda, Angola</dd></div>
          <div><dt>Cliente</dt><dd>Entidade privada · identidade confidencial</dd></div>
        </dl>
      </div>
      <p class="works-catalogue-featured-description">Registo fotográfico de uma intervenção de construção civil em Luanda. As imagens documentam a montagem de cofragem e o posicionamento de armaduras num elemento de fundação, o assentamento de blocos de betão e a execução de uma parede com vão de acesso. A identificação do cliente é omitida a seu pedido.</p>
      <div class="works-catalogue-featured-grid">
        <figure><Image src={luandaFormwork} alt="Cofragem e armaduras posicionadas num elemento de fundação numa obra privada em Luanda" width={480} format="jpg" quality={82} loading="lazy" decoding="async" /><figcaption><strong>01 · Cofragem e armadura</strong><span>Preparação de elemento de fundação</span></figcaption></figure>
        <figure><Image src={luandaMasonry} alt="Pormenor de parede em blocos de betão numa obra privada em Luanda" width={480} format="jpg" quality={82} loading="lazy" decoding="async" /><figcaption><strong>02 · Alvenaria em blocos</strong><span>Detalhe de assentamento</span></figcaption></figure>
        <figure><Image src={luandaOverview} alt="Parede em blocos de betão com vão de acesso numa obra privada em Luanda" width={480} format="jpg" quality={82} loading="lazy" decoding="async" /><figcaption><strong>03 · Parede e vão de acesso</strong><span>Vista geral da frente de alvenaria</span></figcaption></figure>
      </div>
      <p class="works-catalogue-case-note">A localização é indicada ao nível do município para preservar a confidencialidade do cliente. As fotografias documentam fases de execução e não constituem, isoladamente, um auto de medição ou certificado técnico.</p>
    </section>
    <section class="works-catalogue-body section-pad" id="obras" aria-labelledby="pages-catalogo-obras-index-section-2-heading">
      <div class="section-heading">
        <div><div class="section-kicker">02 / REGISTOS DE EXECUÇÃO</div><h2 id="pages-catalogo-obras-index-section-2-heading">Obras e intervenções<br /><em>documentadas em fotografia.</em></h2></div>
        <p>Registos de estruturas, preparação de terrenos, alvenaria, coberturas, reservatórios e trabalhos complementares. Cada legenda descreve apenas o que a imagem permite observar.</p>
      </div>
      <div class="works-catalogue-grid">
        {works.filter((work) => work.group !== "supply").map((work,index) => (
          <article class="works-catalogue-card">
            <figure><Picture src={work.image} alt={work.alt} widths={[480,720,1040]} sizes="(max-width:650px) 100vw, (max-width:1000px) 50vw, 33vw" formats={["webp"]} fallbackFormat="jpg" quality={82} decoding="async" loading="lazy" /></figure>
            <div class="works-catalogue-copy"><span>{String(index+1).padStart(2,"0")} · {work.category}</span><h3>{work.title}</h3><p>{work.description}</p></div>
          </article>
        ))}
      </div>
    </section>
    <section class="works-catalogue-supply section-pad" id="fornecimentos" aria-labelledby="works-catalogue-supply-heading">
      <div class="section-heading"><div><div class="section-kicker">03 / MATERIAIS E LOGÍSTICA</div><h2 id="works-catalogue-supply-heading">Fornecimento e mobilização<br /><em>de materiais.</em></h2></div><p>Registos visuais de materiais e transporte. As imagens não representam confirmação de stock ou disponibilidade actual.</p></div>
      <div class="works-catalogue-grid works-catalogue-supply-grid">
        {works.filter((work) => work.group === "supply").map((work,index) => (
          <article class="works-catalogue-card">
            <figure><Picture src={work.image} alt={work.alt} widths={[480,720,1040]} sizes="(max-width:650px) 100vw, (max-width:1000px) 50vw, 33vw" formats={["webp"]} fallbackFormat="jpg" quality={82} decoding="async" loading="lazy" /></figure>
            <div class="works-catalogue-copy"><span>{String(index+1).padStart(2,"0")} · {work.category}</span><h3>{work.title}</h3><p>{work.description}</p></div>
          </article>
        ))}
      </div>
      <p class="works-catalogue-note">Este catálogo é um arquivo visual comercial. Não substitui contratos, autos de medição, faturas ou outros documentos de comprovação. A HMATIAS identifica clientes, datas e localizações apenas quando essa divulgação é adequada ou autorizada.</p>
    </section>
    <section class="works-catalogue-cta" aria-labelledby="pages-catalogo-obras-index-section-3-heading">
      <div><p class="section-kicker">TEM UMA OBRA OU INTERVENÇÃO?</p><h2 id="pages-catalogo-obras-index-section-3-heading">Apresente o seu projeto<br /><em>à HMATIAS.</em></h2><p>Envie localização, fotografias, medidas aproximadas e uma descrição breve para estruturarmos o próximo passo.</p></div>
      <a class="button button-light" href={company.contactFormUrl} target="_blank" rel="noopener noreferrer">Solicitar avaliação <span aria-hidden="true">↗</span></a>
    </section>
  </main>
  <SiteFooter />
  <div class="preview-disclaimer">Protótipo tecnológico independente. Não substitui nem modifica o website oficial da HMATIAS.</div>
</BaseLayout>
<style>
.works-catalogue-hero { padding:clamp(70px,9vw,115px) var(--hm-gutter); color:#fff; background:var(--hm-navy); }
.works-catalogue-hero-inner { max-width:900px; }
.works-catalogue-hero h1 { margin:0; font-size:clamp(44px,6vw,82px); font-weight:520; line-height:1.02; letter-spacing:-.065em; }
.works-catalogue-hero h1 em { color:#b9d8ed; font-family:var(--hm-serif); font-weight:400; }
.works-catalogue-hero > div > p:not(.eyebrow) { max-width:680px; margin:26px 0 0; color:#dceafa; font-size:13px; line-height:1.85; }
.works-catalogue-hero .hero-actions { margin-top:32px; }
.works-catalogue-body,.works-catalogue-supply { background:var(--hm-paper); }
.works-catalogue-featured { background:#f2f6f9; }
.works-catalogue-featured-heading { display:grid; grid-template-columns:minmax(0,1.4fr) minmax(220px,.8fr); gap:36px; align-items:end; }
.works-catalogue-featured-heading h2 { margin:0; color:var(--hm-ink); font-size:clamp(30px,4vw,48px); font-weight:550; line-height:1.08; letter-spacing:-.055em; }
.works-catalogue-featured-heading h2 em { color:var(--hm-blue); font-family:var(--hm-serif); font-weight:400; }
.works-catalogue-project-meta { margin:0; display:grid; gap:12px; }
.works-catalogue-project-meta div { padding:0 0 10px; border-bottom:1px solid var(--hm-line); }
.works-catalogue-project-meta dt { color:var(--hm-muted); font-size:9px; font-weight:750; letter-spacing:.1em; text-transform:uppercase; }
.works-catalogue-project-meta dd { margin:5px 0 0; color:var(--hm-ink); font-size:12px; line-height:1.5; font-weight:600; }
.works-catalogue-featured-description { max-width:920px; margin:24px 0 0; color:var(--hm-muted); font-size:13px; line-height:1.85; }
.works-catalogue-featured-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; margin-top:32px; }
.works-catalogue-featured-grid figure { margin:0; min-width:0; background:#fff; }
.works-catalogue-featured-grid img { display:block; width:100%; height:auto; aspect-ratio:4/3; object-fit:contain; background:#fff; }
.works-catalogue-featured-grid figcaption { display:grid; gap:5px; padding:13px 14px 16px; }
.works-catalogue-featured-grid figcaption strong { color:var(--hm-ink); font-size:12px; line-height:1.4; }
.works-catalogue-featured-grid figcaption span { color:var(--hm-muted); font-size:10px; line-height:1.5; }
.works-catalogue-case-note { margin:24px 0 0; color:var(--hm-muted); font-size:10px; line-height:1.75; }
.works-catalogue-supply { border-top:1px solid var(--hm-line); }
.works-catalogue-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); align-items:start; gap:35px 22px; margin-top:55px; }
.works-catalogue-card { min-width:0; }
.works-catalogue-card figure { margin:0; background:var(--hm-light); }
.works-catalogue-card figure img { display:block; width:100%; height:auto; object-fit:contain; }
.works-catalogue-copy { padding:16px 2px 0; }
.works-catalogue-copy > span { color:var(--hm-blue); font-size:9px; font-weight:700; letter-spacing:.09em; text-transform:uppercase; }
.works-catalogue-copy h3 { margin:10px 0 8px; color:var(--hm-ink); font-size:16px; line-height:1.35; font-weight:650; letter-spacing:-.025em; }
.works-catalogue-copy p { margin:0; color:var(--hm-muted); font-size:11px; line-height:1.8; }
.works-catalogue-note { max-width:900px; margin:44px auto 0; padding:19px 22px; color:var(--hm-muted); background:var(--hm-light); border-left:2px solid var(--hm-blue); font-size:10px; line-height:1.8; }
.works-catalogue-cta { padding:clamp(60px,8vw,95px) var(--hm-gutter); display:flex; justify-content:space-between; align-items:center; gap:35px; color:#fff; background:var(--hm-navy); }
.works-catalogue-cta .section-kicker { margin:0 0 18px; padding:0; color:#b9d8ed; }
.works-catalogue-cta h2 { margin:0; font-size:clamp(35px,4.5vw,58px); line-height:1.07; letter-spacing:-.06em; font-weight:520; }
.works-catalogue-cta h2 em { color:#b9d8ed; font-family:var(--hm-serif); font-weight:400; }
.works-catalogue-cta > div > p:not(.section-kicker) { max-width:560px; margin:16px 0 0; color:#dceafa; font-size:11px; line-height:1.8; }
@media(max-width:950px) { .works-catalogue-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
@media(max-width:650px) { .works-catalogue-grid { grid-template-columns:1fr; gap:28px; margin-top:35px; } .works-catalogue-cta { flex-direction:column; align-items:flex-start; } .works-catalogue-featured-heading { grid-template-columns:1fr; gap:22px; } .works-catalogue-featured-grid { grid-template-columns:1fr; } }
</style>
