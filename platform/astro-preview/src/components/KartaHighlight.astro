---
const isEnglish = Astro.url.pathname.startsWith("/en/");
---

<section class="karta-highlight" aria-labelledby="karta-highlight-heading">
  <div class="karta-highlight-inner">
    <div class="karta-highlight-copy">
      <p class="karta-highlight-kicker">{isEnglish ? "DIGITAL PROJECT · ALPHA" : "PROJECTO DIGITAL · ALPHA"}</p>
      <h2 id="karta-highlight-heading">KARTA Wallet Mobile</h2>
      <p>{isEnglish
        ? "A digital identity wallet in development. The project remains in Alpha while its core experience and controlled document-management approach are being validated."
        : "Uma carteira digital de identidade em desenvolvimento. O projecto permanece em fase Alpha, com a experiência principal e a gestão controlada de documentos em validação."}</p>
    </div>
    <a class="karta-highlight-link" href={isEnglish ? "/en/karta/" : "/karta/"}>
      {isEnglish ? "Explore the Alpha project" : "Conhecer o projecto Alpha"}
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>

<style>
  .karta-highlight {
    padding: clamp(40px, 6vw, 72px) var(--hm-gutter);
    color: #fff;
    background: var(--hm-navy);
  }
  .karta-highlight-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: clamp(24px, 5vw, 72px);
    max-width: 1440px;
    margin-inline: auto;
  }
  .karta-highlight-copy { max-width: 760px; }
  .karta-highlight-kicker {
    margin: 0 0 17px;
    color: #b9d8ed;
    font-size: 9px;
    font-weight: 750;
    letter-spacing: .16em;
  }
  .karta-highlight h2 {
    margin: 0;
    font-size: clamp(30px, 4vw, 48px);
    font-weight: 520;
    line-height: 1.08;
    letter-spacing: -.055em;
  }
  .karta-highlight-copy > p:last-child {
    max-width: 650px;
    margin: 18px 0 0;
    color: #dceafa;
    font-size: 12px;
    line-height: 1.85;
  }
  .karta-highlight-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    min-width: 205px;
    padding: 13px 0;
    color: #fff;
    border-bottom: 1px solid #b9d8ed;
    font-size: 10px;
    font-weight: 700;
    text-decoration: none;
  }
  .karta-highlight-link:hover { color: #b9d8ed; }
  .karta-highlight-link span { font-size: 15px; }
  @media (max-width: 680px) {
    .karta-highlight-inner { grid-template-columns: 1fr; align-items: start; }
    .karta-highlight-link { width: 100%; max-width: 320px; }
  }
</style>
