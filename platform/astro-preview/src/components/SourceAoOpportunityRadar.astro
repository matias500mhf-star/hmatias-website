---
import sourceLogo from "../../../../images/source-ao-logo.svg";

interface Props {
  apiBase?: string;
  lang?: "pt-AO" | "en";
}
const { apiBase = "", lang = "pt-AO" } = Astro.props;
const english = lang === "en";
const homeUrl = english ? "/en/source-ao/" : "/source-ao/";
const rfqUrl = english ? "/en/source-ao/smart-rfq/" : "/source-ao/smart-rfq/";
---

<div class="op-body">
  <div class="source-radar-preview-bar">
    <a href={homeUrl} id="radarHomeLink">SOURCE AO</a>
    <span>{english ? "PUBLIC OPPORTUNITY RADAR · PREVIEW" : "RADAR PÚBLICO DE OPORTUNIDADES · PRÉ-VISUALIZAÇÃO"}</span>
  </div>
  {!apiBase && <p class="source-radar-stage-note" role="status">{english ? "Isolated preview: the live opportunity feed is disabled until a staging API is configured. No production data is requested or displayed here." : "Pré-visualização isolada: o feed de oportunidades só é ligado após configuração da API de staging. Esta página não consulta nem apresenta dados de produção."}</p>}
  {apiBase && <p class="source-radar-stage-note" role="status">{english ? "Staging feed. Only public opportunities approved for publication and with a valid deadline are displayed." : "Feed de staging. São apresentadas apenas oportunidades públicas aprovadas para publicação e com prazo válido."}</p>}

  <header class="topbar op-topbar">
    <div class="shell nav">
      <a class="source-brand" href={homeUrl} aria-label="SOURCE AO" id="radarBrandLink">
        <img src={sourceLogo.src} alt="SOURCE AO by HMATIAS" width="190" height="90">
      </a>
      <div class="nav-actions">
        <a class="source-header-email" href="mailto:geral@comercialhmatiasps.com" aria-label={english ? "HMATIAS commercial email" : "E-mail comercial HMATIAS"}>
          <span aria-hidden="true">✉</span>
        </a>
        <span class="op-live-pill"><i></i><span id="liveStateLabel">{apiBase ? (english ? "Staging feed" : "Feed de staging") : (english ? "Preview only" : "Pré-visualização")}</span></span>
        <button class="lang" type="button" id="langToggle" aria-label={english ? "Switch to Portuguese" : "Mudar para inglês"}>{english ? "PT" : "EN"}</button>
        <a class="btn btn-outline btn-small" id="radarBackLink" href={homeUrl} data-i18n="back">{english ? "← Source AO" : "← Source AO"}</a>
      </div>
    </div>
  </header>

  <main data-radar-preview>
    <section class="op-hero">
      <div class="shell">
        <div class="op-hero-top">
          <div class="op-hero-copy">
            <p class="op-eyebrow" data-i18n="eyebrow">SOURCE AO · INTELLIGENCE RADAR</p>
            <h1 data-i18n="title">Não veja apenas oportunidades.<br><span>Entenda quais merecem ação.</span></h1>
            <p data-i18n="lead">O Radar cruza prazo, fonte, setor, localização e compatibilidade comercial para transformar anúncios dispersos em prioridades de negócio verificáveis.</p>
          </div>
          <div class="op-engine-badge" aria-label="Source Intelligence Core">
            <span class="op-engine-icon">S</span>
            <div><small>SOURCE INTELLIGENCE</small><strong>CORE v1</strong><em data-i18n="engineState">Motor ativo</em></div>
          </div>
        </div>
        <div class="op-stat-grid" aria-label={english ? "Radar summary" : "Resumo do radar"}>
          <article><small data-i18n="statActive">Oportunidades ativas</small><strong id="activeCount">—</strong><span data-i18n="statActiveNote">com prazo válido</span></article>
          <article><small data-i18n="statHighFit">Fit elevado</small><strong id="highFitCount">—</strong><span data-i18n="statHighFitNote">score ≥ 80</span></article>
          <article><small data-i18n="statUrgent">Ação urgente</small><strong id="urgentCount">—</strong><span data-i18n="statUrgentNote">≤ 5 dias</span></article>
          <article><small data-i18n="statMarkets">Mercado</small><strong id="marketCount">AO</strong><span data-i18n="statMarketsNote">Angola</span></article>
        </div>
      </div>
    </section>

    <section class="op-control shell">
      <div class="op-control-copy">
        <p class="op-eyebrow dark" data-i18n="currentEyebrow">PRIORIDADE COMERCIAL</p>
        <h2 data-i18n="currentTitle">Opportunity Intelligence</h2>
        <p data-i18n="currentLead">Ordenado pelo prazo, pela adequação à HMATIAS e pela confiança na fonte. A participação exige análise dos documentos do procedimento.</p>
      </div>
      <div class="op-filter-stack">
        <label class="op-radar-search">
          <small data-i18n="searchLabel">PESQUISAR</small>
          <input id="opportunitySearch" type="search" autocomplete="off" data-i18n-placeholder="searchPlaceholder" placeholder="Ex.: canalização, pintura, manutenção…">
        </label>
        <div class="op-filter-group">
          <small data-i18n="areaLabel">ÁREA</small>
          <div class="op-filters" aria-label={english ? "Filter by business area" : "Filtros por área de negócio"}>
            <button class="active" data-area="all" data-i18n="filterAll">Todas</button>
            <button data-area="construction" data-i18n="areaConstruction">Construção</button>
            <button data-area="facilities" data-i18n="areaFacilities">Facilities</button>
            <button data-area="plumbing" data-i18n="areaPlumbing">Canalização</button>
            <button data-area="electrical-hvac" data-i18n="areaElectrical">Elétrica / HVAC</button>
            <button data-area="supply" data-i18n="areaSupply">Fornecimento</button>
            <button data-area="subcontracting" data-i18n="areaSubcontracting">Subcontratação</button>
          </div>
        </div>
        <div class="op-filter-group">
          <small data-i18n="formatLabel">FORMATO</small>
          <div class="op-filters op-format-filters" aria-label={english ? "Filter by opportunity type" : "Filtros por formato"}>
            <button class="active" data-format="all" data-i18n="formatAll">Todos</button>
            <button data-format="rfq">RFQ</button>
            <button data-format="tender" data-i18n="filterTender">Concurso</button>
          </div>
        </div>
      </div>
    </section>

    <section class="shell op-workspace">
      <div class="op-syncbar">
        <div class="op-sync-status" role="status" aria-live="polite">
          <span class="op-sync-dot" aria-hidden="true"></span>
          <div><strong id="syncStatus">{english ? "Waiting for staging connection…" : "À espera da ligação ao staging…"}</strong><small id="syncMeta">{english ? "Automatic refresh every 5 minutes" : "Atualização automática a cada 5 minutos"}</small></div>
        </div>
        <button class="op-refresh-button" type="button" id="refreshRadar">
          <span class="op-refresh-icon" aria-hidden="true">↻</span>
          <span id="refreshRadarLabel">{english ? "Refresh now" : "Atualizar agora"}</span>
        </button>
      </div>
      <div class="op-workspace-head">
        <div><span class="op-pulse" aria-hidden="true"></span><strong data-i18n="workspaceTitle">Fila inteligente de oportunidades</strong></div>
        <span id="visibleCount">—</span>
      </div>
      <div class="op-list" id="opList"><p class="op-loading" data-i18n="loading">A carregar inteligência de oportunidades…</p></div>
      <div class="op-trust-note">
        <span aria-hidden="true">i</span>
        <p data-i18n="disclaimer">Fit e confiança são sinais de triagem, não garantias de elegibilidade ou adjudicação. Confirme sempre a fonte original, os documentos do procedimento e os requisitos de qualificação.</p>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="shell footer-main">
      <a class="source-brand source-brand-footer" href={homeUrl} id="radarFooterHomeLink"><img src={sourceLogo.src} alt="SOURCE AO by HMATIAS" width="190" height="90" loading="lazy"></a>
      <p>Search. Verify. Decide. Act.</p>
      <span></span>
      <a class="service-by service-by-link" href={homeUrl}><span data-i18n="serviceBy">Um serviço da HMATIAS</span> ↗</a>
    </div>
    <div class="source-radar-footer-links"><a href={rfqUrl}>{english ? "Submit a sourcing request" : "Submeter pedido de sourcing"}</a><a href={english ? "/en/source-ao/partners/" : "/source-ao/parceiros/"}>{english ? "Partner application" : "Candidatura de parceiros"}</a><a href="mailto:geral@comercialhmatiasps.com">geral@comercialhmatiasps.com</a></div>
  </footer>
</div>

<script is:inline define:vars={{ apiBase }}>
  window.SOURCE_AO_RUNTIME = Object.freeze({ environment: "preview", apiBase: typeof apiBase === "string" ? apiBase : "" });
</script>
<script>
  import "../../../../source-ao/api-client.js";
  import "../../../../source-ao/opportunity-radar.js";
</script>
<style>
  @import "../../../../source-ao/sourceao.css";
  @import "../../../../source-ao/opportunity-radar.css";
  .source-radar-preview-bar{display:flex;justify-content:space-between;gap:18px;padding:10px clamp(16px,5vw,72px);background:#061827;color:#c8d7e4;font-size:10px;font-weight:750;letter-spacing:.12em}
  .source-radar-preview-bar a{color:#fff;text-decoration:none}
  .source-radar-stage-note{margin:0;padding:11px clamp(16px,5vw,72px);background:#f6f9fb;border-bottom:1px solid #dce5ec;color:#526879;font-size:11px;line-height:1.55}
  .source-radar-footer-links{display:flex;justify-content:center;flex-wrap:wrap;gap:16px 28px;padding:0 20px 20px;background:#031f3d;color:#d9e7f0;font-size:11px}
  .source-radar-footer-links a{color:inherit}
  @media(max-width:560px){.source-radar-preview-bar{flex-direction:column;gap:5px}.source-radar-footer-links{flex-direction:column;align-items:center;gap:10px}}
</style>
