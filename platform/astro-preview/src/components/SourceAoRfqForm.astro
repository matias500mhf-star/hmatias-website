---
import sourceLogo from "../../../../images/source-ao-logo.svg";

interface Props {
  apiBase?: string;
}

const { apiBase = "" } = Astro.props;
---

<a class="skip-link" href="#rfqForm" data-en="Skip to request">Ir para o pedido</a>
  <header class="rfq-header">
    <a id="sourceAoLogoLink" href="/source-ao/" aria-label="SOURCE AO"><img src={sourceLogo.src} width="190" height="90" alt="SOURCE AO by HMATIAS"></a>
    <nav><a class="source-header-email" href="mailto:geral@comercialhmatiasps.com" data-en="HMATIAS contact">Contacto HMATIAS</a><a id="sourceAoBackLink" href="/source-ao/" data-en="Back to SOURCE AO">Voltar ao SOURCE AO</a><button id="rfqLanguage" type="button" aria-label="Mudar para EN — English">EN</button></nav>
  </header>
  <main class="rfq-shell">
    <div class="rfq-heading"><span class="eyebrow">HMATIAS SUPPLY · RFQ</span><h1 data-en="What do you need to source?">O que precisa de encontrar?</h1><p data-en="Select a supply family or describe the exact item. HMATIAS reviews the specification and confirms supply and delivery conditions before preparing a proposal.">Indique uma família de fornecimento ou descreva o artigo exato. A HMATIAS analisa a especificação e confirma as condições de fornecimento e entrega antes de preparar uma proposta.</p></div>
    <div class="rfq-layout">
      <section class="rfq-workspace" aria-label="Pedido de cotação">
        <ol class="rfq-progress" aria-label="Etapas do pedido"><li aria-current="step"><span>1</span><b data-en="Items">Artigos</b></li><li><span>2</span><b data-en="Delivery">Entrega</b></li><li><span>3</span><b data-en="Contact & review">Contacto e revisão</b></li></ol>
        <p id="catalogStatus" class="rfq-notice" role="status" data-en="Loading supply families…">A carregar famílias de fornecimento…</p>
        <form id="rfqForm" novalidate>
          <fieldset data-step="0"><legend data-en="Your item list">A sua lista de artigos</legend><p class="field-help" data-en="Choose a supply family or describe the exact item. Fields marked * are required.">Escolha uma família de fornecimento ou descreva o artigo exato. Os campos com * são obrigatórios.</p><div id="rfqItems"></div><button class="text-button" id="addItem" type="button" data-en="+ Add another item">+ Adicionar outro artigo</button></fieldset>
          <fieldset data-step="1" hidden><legend data-en="Delivery and purchasing needs">Entrega e condições do pedido</legend><div id="deliveryFields" class="field-grid"></div></fieldset>
          <fieldset data-step="2" hidden><legend data-en="Who should receive the proposal?">Quem deve receber a proposta?</legend><div id="contactFields" class="field-grid"></div><div id="rfqReview" class="rfq-review"></div><label class="consent"><input id="rfqConsent" type="checkbox" required><span data-en="I authorise HMATIAS to use these details to assess and respond to this request. I have read the Privacy notice.">Autorizo a HMATIAS a utilizar estes dados para avaliar e responder ao pedido. Li o aviso de Privacidade.</span></label><p class="field-help"><a id="rfqPrivacyNoticeLink" href="/privacidade/" target="_blank" rel="noopener" data-en="Read Privacy notice">Ler aviso de Privacidade</a> · <a id="rfqTermsLink" href="/termos/" target="_blank" rel="noopener" data-en="Terms">Termos</a></p></fieldset>
          <div class="honeypot" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div>
          <p id="rfqError" class="rfq-error" role="alert" hidden></p>
          <div class="rfq-navigation"><button id="rfqBack" class="secondary" type="button" hidden data-en="Back">Voltar</button><button id="rfqNext" class="primary" type="button" data-en="Continue to delivery">Continuar para entrega</button><button id="rfqSubmit" class="primary" type="submit" hidden data-en="Send quotation request">Enviar pedido de cotação</button></div>
        </form>
        <div id="rfqResult" class="rfq-result" tabindex="-1" hidden aria-live="polite"></div>
        <noscript><p>Ative JavaScript para registar o pedido ou contacte a HMATIAS pelo <a href="https://wa.me/244948806673">WhatsApp (+244) 948 806 673</a>.</p></noscript>
      </section>
      <aside class="rfq-aside"><div class="aside-card"><span class="eyebrow" data-en="YOUR REQUEST">O SEU PEDIDO</span><strong id="itemCount">1 artigo</strong><p id="categorySummary" data-en="Choose a supply family to get started.">Escolha uma família de fornecimento para começar.</p><hr><h2 data-en="What happens next?">O que acontece a seguir?</h2><ol><li data-en="We check the quantities and technical requirements.">Validamos as quantidades e os requisitos técnicos.</li><li data-en="We confirm supply options and delivery terms.">Confirmamos as opções de fornecimento e entrega.</li><li data-en="You receive a proposal to review and approve.">Recebe uma proposta para analisar e adjudicar.</li></ol><p class="aside-note" data-en="A quotation request is not a purchase. Prices and lead times require confirmation.">O pedido de cotação não constitui uma compra. Preços e prazos dependem de confirmação.</p></div><p class="contact-note" data-en="Your details are used for this request. Save the private tracking link after sending.">Os seus dados são usados neste pedido. Após enviar, guarde o link privado de acompanhamento.</p></aside>
    </div>
  </main>
  <footer class="rfq-footer"><span>SOURCE AO · HMATIAS</span><a id="sourceAoSupplyLink" href="/supply/" data-en="HMATIAS Supply">HMATIAS Supply</a><a id="sourceAoPrivacyLink" href="/privacidade/" data-en="Privacy">Privacidade</a><div class="sitewide-contact-details" style="display:flex;flex-wrap:wrap;gap:12px 18px;align-items:center;justify-content:center;padding:10px 0"><a href="mailto:geral@comercialhmatiasps.com" style="display:inline-flex;align-items:center;gap:0">geral@comercialhmatiasps.com</a><a href="mailto:info@comercialhmatiasps.com" style="display:inline-flex;align-items:center;gap:0">info@comercialhmatiasps.com · Informação institucional</a></div></footer>

<script is:inline define:vars={{ apiBase }}>
  window.SOURCE_AO_RUNTIME = Object.freeze({
    environment: "preview",
    apiBase: typeof apiBase === "string" ? apiBase : ""
  });
</script>
<script>
  import "../../../../source-ao/rfq.js";
</script>
<style>
  @import "../../../../source-ao/rfq.css";
</style>
