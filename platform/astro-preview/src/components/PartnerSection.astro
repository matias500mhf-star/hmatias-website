---
import miliartLogo from "../../../../images/partners/miliart-intemporal-logo.png";
import fransgaLogo from "../../../../images/partners/fransga-logo.png";
import dwoodLogo from "../../../../images/partners/dwood-logo.jpg";
import synvorLogo from "../../../../images/partners/synvor-industrial-logo.png";
import kentOffshoreLogo from "../../../../images/partners/kent-offshore-logo.png";
import { company } from "../data/site";
const isEnglish = Astro.url.pathname.startsWith("/en/");
---
<section class="partner-section" aria-labelledby="partner-section-heading">
  <div class="partner-section-head"><div>
    <p class="section-kicker">{isEnglish ? "PARTNER NETWORK" : "REDE DE PARCEIROS"}</p>
    <h2 id="partner-section-heading">{isEnglish ? <>Working together.<br /><em>Delivering with reach.</em></> : <>Parcerias que ampliam<br /><em>a capacidade de resposta.</em></>}</h2>
    <p>{isEnglish ? "A network of specialist companies supports selected requirements across supply, technical solutions and project delivery. Each engagement is confirmed against the scope of the specific project." : "Uma rede de empresas especializadas apoia necessidades seleccionadas em fornecimento, soluções técnicas e execução de projetos. A participação de cada entidade é confirmada em função do âmbito de cada trabalho."}</p>
  </div></div>
  <div class="partner-logos" aria-label={isEnglish ? "Featured partner identities" : "Identidades de parceiros em destaque"}>
    <a class="partner-logo partner-logo-miliart" href="https://www.miliart-angola.com/" target="_blank" rel="noopener noreferrer" aria-label={isEnglish ? "Miliart official website" : "Website oficial da Miliart"}>
      <img src={miliartLogo.src} alt="Miliart" width="320" height="142" loading="lazy" decoding="async" />
    </a>
    <div class="partner-logo">
      <img src={fransgaLogo.src} alt="FRANSGA — Comércio e Prestação de Serviços" width="320" height="142" loading="lazy" decoding="async" />
    </div>
    <div class="partner-logo partner-logo-dwood">
      <img src={dwoodLogo.src} alt="D&WOOD" width="320" height="142" loading="lazy" decoding="async" />
    </div>
    <div class="partner-logo partner-logo-telewise">
      <span class="partner-name">Telewise</span>
    </div>
    <a class="partner-logo partner-logo-synvor" href="https://synvor-industrial.com/" target="_blank" rel="noopener noreferrer" aria-label={isEnglish ? "SYNVOR Industrial official website" : "Website oficial da SYNVOR Industrial"}>
      <img src={synvorLogo.src} alt="SYNVOR Industrial" width="320" height="142" loading="lazy" decoding="async" />
    </a>
    <div class="partner-logo">
      <img src={kentOffshoreLogo.src} alt="Kent Offshore" width="320" height="142" loading="lazy" decoding="async" />
    </div>
  </div>
  <div class="partner-section-foot">
    <p>{isEnglish ? "Partner participation depends on the project scope, technical fit and confirmation of availability." : "A participação de cada parceiro depende do âmbito do projeto, da adequação técnica e da confirmação de disponibilidade."}</p>
    <a href={isEnglish ? company.partnerApplicationEnUrl : company.partnerApplicationUrl}>{isEnglish ? "Become a partner" : "Apresentar candidatura a parceiro"} <span aria-hidden="true">↗</span></a>
  </div>
</section>
