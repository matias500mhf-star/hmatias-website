---
import { Image } from "astro:assets";
import logo from "../../../../logo-hmatias.png";
import { company } from "../data/site";
---

<footer class="site-footer">
  <div class="footer-main">
    <section class="footer-column footer-identity" aria-label="Identidade e plataformas HMATIAS">
      <a class="footer-logo" href="#inicio" aria-label="HMATIAS — voltar ao início">
        <Image src={logo} alt="HMATIAS — Prestação de Serviços" widths={[96, 128]} sizes="64px" format="webp" quality={82} />
      </a>
      <p class="footer-company">{company.legalName}</p>
      <p class="footer-summary">Construção, Facilities, Supply e Business Services para empresas e projetos em Angola.</p>
      <a class="footer-platform-link" href={company.sourceAoUrl}>SOURCE AO <span>↗</span></a>
      <a href="/blog/">Blog · Perspetivas empresariais</a>
    </section>

    <nav class="footer-column" aria-label="Construção">
      <h2>Construção</h2>
      <a href={company.constructionUrl}>Construção Civil</a>
      <a href={company.remodelingUrl}>Remodelação</a>
      <a href={company.facilitiesUrl}>Facilities e Manutenção</a>
      <a href={company.projectsUrl}>Projetos</a>
      <a href={company.worksCatalogueUrl}>Catálogo de Obras</a>
    </nav>

    <nav class="footer-column" aria-label="Serviços">
      <h2>Serviços</h2>
      <a href={company.supplyUrl}>HMATIAS Supply</a>
      <a href={company.businessServicesUrl}>Business Services</a>
      <a href={company.smartRfqUrl}>Smart RFQ</a>
      <a href="#contacto">Solicitar orçamento</a>
    </nav>

    <section class="footer-column footer-contacts" aria-label="Contacto e localização">
      <h2>Contacto e localização</h2>
      <a href={company.telephoneUri}>{company.phone}</a>
      <a class="footer-whatsapp" href={company.whatsappUri} target="_blank" rel="noopener noreferrer">WhatsApp <span aria-hidden="true">↗</span></a>
      <a href={`mailto:${company.commercialEmail}`}>{company.commercialEmail}</a>
      <a href={`mailto:${company.institutionalEmail}`}>{company.institutionalEmail}</a>
      <address>{company.address}</address>
      <div class="footer-socials" aria-label="Redes sociais">
        <a href={company.instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Instagram HMATIAS">Instagram <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>

  <div class="footer-bottom">
    <p class="footer-legal-id">© {new Date().getFullYear()} {company.legalName} · NIF {company.taxNumber} · Registo Comercial {company.commercialRegistration}. Todos os direitos reservados.</p>
    <nav class="footer-legal-links" aria-label="Informação legal">
      <a href={company.partnerApplicationUrl}>Parcerias</a>
      <a href={company.credibilityUrl}>Credibilidade</a>
      <a href={company.privacyUrl}>Política de Privacidade</a>
      <a href={company.termsUrl}>Termos e Condições</a>
      <a href="/acessibilidade/">Acessibilidade</a>
    </nav>
    <a class="footer-back-top" href="#inicio">Voltar ao topo <span aria-hidden="true">↑</span></a>
  </div>
</footer>