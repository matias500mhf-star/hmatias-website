---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";

type ServiceKey = "industrial-roofing" | "post-construction-cleaning" | "ppe-workwear" | "office-remodelling";
interface Props { service: ServiceKey; lang?: "pt-AO" | "en"; }
const { service, lang = "pt-AO" } = Astro.props;
const en = lang === "en";

const content = {
  "industrial-roofing": {
    pt: {
      parent: "Construção e Remodelação", parentHref: "/construcao/", area: "construction",
      eyebrow: "HMATIAS · CONSTRUÇÃO CIVIL",
      title: "Coberturas industriais: avaliação, reparação e manutenção.",
      description: "Uma cobertura em mau estado pode afectar a continuidade da operação, os equipamentos e as áreas de trabalho. A HMATIAS recebe pedidos para avaliação de intervenções em coberturas industriais e estruturas associadas, com definição do âmbito após análise do local e das condições técnicas.",
      conditionTitle: "Execução sujeita a avaliação",
      condition: "Materiais, acessos, segurança, mobilização, quantidades e prazo são verificados antes da proposta e da confirmação do serviço.",
      scopeTitle: "O que pode ser avaliado",
      scopeLead: "O âmbito final depende da inspecção, das condições de acesso e da necessidade técnica identificada.",
      scope: [
        ["Inspecção visual e levantamento", "Registo das condições observáveis, identificação preliminar de infiltrações, danos aparentes e informação necessária para preparar a proposta."],
        ["Reparação localizada", "Avaliação de chapas, remates, fixações e outros elementos da cobertura que possam exigir intervenção, conforme o diagnóstico e os materiais adequados."],
        ["Manutenção programada", "Definição de intervenções preventivas e prioridades de manutenção, quando tecnicamente viáveis e acordadas com o cliente."]
      ],
      requestTitle: "Informação que ajuda a acelerar a avaliação",
      requestLead: "Para uma análise inicial mais rigorosa, inclua os dados disponíveis, sem substituir o levantamento técnico.",
      request: [
        ["Localização e acesso", "Província, município, tipo de instalação e condições conhecidas de acesso à cobertura."],
        ["Condição actual", "Fotografias à distância segura, descrição das anomalias observadas e indicação de infiltrações ou danos visíveis."],
        ["Dimensão e prazo", "Área aproximada, tipo de cobertura, urgência, horário permitido para os trabalhos e eventuais restrições operacionais."]
      ],
      ctaTitle: "Solicite uma avaliação da cobertura.",
      ctaText: "A HMATIAS confirma o âmbito, as condições de execução e a proposta após analisar a informação do pedido. A submissão não confirma disponibilidade nem preço.",
      cta: "Preparar pedido técnico"
    },
    en: {
      parent: "Construction and Remodelling", parentHref: "/en/construction/", area: "construction",
      eyebrow: "HMATIAS · CIVIL CONSTRUCTION",
      title: "Industrial roofing: assessment, repair and maintenance.",
      description: "A roof in poor condition can affect operations, equipment and work areas. HMATIAS receives requests to assess industrial roofing and related structures. The scope is defined after reviewing the site and its technical conditions.",
      conditionTitle: "Execution subject to assessment",
      condition: "Materials, access, safety, mobilisation, quantities and timing are checked before a proposal and service confirmation.",
      scopeTitle: "What can be assessed",
      scopeLead: "The final scope depends on the inspection, access conditions and identified technical requirements.",
      scope: [
        ["Visual inspection and survey", "Record observable conditions, make a preliminary identification of leaks and visible damage, and gather information required for a proposal."],
        ["Localised repairs", "Assess roof sheets, flashings, fixings and other elements that may require intervention, according to the diagnosis and suitable materials."],
        ["Scheduled maintenance", "Define preventive interventions and maintenance priorities where technically feasible and agreed with the client."]
      ],
      requestTitle: "Information that helps the initial assessment",
      requestLead: "Provide the available details for an initial review; these do not replace a technical survey.",
      request: [
        ["Location and access", "Province, municipality, facility type and known access conditions for the roof."],
        ["Current condition", "Photographs taken from a safe distance, a description of observed issues and any visible leaks or damage."],
        ["Size and timing", "Approximate area, roof type, urgency, permitted work hours and any operational restrictions."]
      ],
      ctaTitle: "Request a roofing assessment.",
      ctaText: "HMATIAS confirms scope, execution conditions and the proposal after reviewing the request. Submitting a brief does not confirm availability or price.",
      cta: "Prepare a technical request"
    }
  },
  "post-construction-cleaning": {
    pt: {
      parent: "Facilities e Manutenção", parentHref: "/facilities/", area: "facilities",
      eyebrow: "HMATIAS FACILITIES",
      title: "Limpeza pós-obra para espaços empresariais.",
      description: "Após uma obra ou remodelação, a remoção de poeiras e resíduos de acabamento é uma etapa importante antes da utilização do espaço. A HMATIAS recebe pedidos de limpeza pós-obra para escritórios, lojas e outras instalações empresariais, com âmbito definido de acordo com a área, o estado do local e as condições de acesso.",
      conditionTitle: "Escopo confirmado antes da execução",
      condition: "Área, nível de sujidade, materiais, equipamentos, resíduos, acesso e prazo são avaliados para definir a proposta.",
      scopeTitle: "Preparação do espaço após a intervenção",
      scopeLead: "As tarefas são acordadas antes do início, com base nas condições observadas e nas necessidades do cliente.",
      scope: [
        ["Superfícies e mobiliário fixo", "Remoção de poeiras de obra em superfícies acessíveis, portas, rodapés, bancadas e elementos incluídos no escopo aprovado."],
        ["Pavimentos e áreas de circulação", "Limpeza de pavimentos e zonas de circulação conforme o tipo de acabamento, o produto adequado e as condições do local."],
        ["Instalações sanitárias e vidros acessíveis", "Tratamento das áreas incluídas na proposta, respeitando o material, as condições de segurança e os limites de acesso acordados."]
      ],
      requestTitle: "O que indicar no pedido",
      requestLead: "Uma descrição clara ajuda a preparar um orçamento adequado ao espaço e ao trabalho pretendido.",
      request: [
        ["Dimensão e tipo de espaço", "Área aproximada, número de divisões, tipo de instalação e localização."],
        ["Estado após a obra", "Tipo de resíduos e poeiras visíveis, presença de tinta, cimento ou outros materiais que exijam tratamento específico."],
        ["Acesso e prazo", "Data pretendida, disponibilidade de água e electricidade, acesso ao edifício e eventuais restrições de horário."]
      ],
      ctaTitle: "Prepare o pedido de limpeza pós-obra.",
      ctaText: "Envie a localização, fotografias do espaço e área aproximada. A cotação e a disponibilidade são confirmadas após avaliação; o pedido não constitui confirmação de adjudicação.",
      cta: "Preparar pedido de limpeza"
    },
    en: {
      parent: "Facilities and Maintenance", parentHref: "/en/facilities/", area: "facilities",
      eyebrow: "HMATIAS FACILITIES",
      title: "Post-construction cleaning for business premises.",
      description: "After construction or remodelling, removing dust and finishing residues is an important step before a space is used. HMATIAS receives post-construction cleaning requests for offices, shops and other business premises. The scope is defined according to the area, site condition and access requirements.",
      conditionTitle: "Scope agreed before execution",
      condition: "Area, level of soiling, materials, equipment, waste, access and timing are assessed to prepare the proposal.",
      scopeTitle: "Preparing the premises after the works",
      scopeLead: "Tasks are agreed before work begins, based on observed conditions and the client's requirements.",
      scope: [
        ["Surfaces and fixed furniture", "Remove construction dust from accessible surfaces, doors, skirting boards, counters and elements included in the approved scope."],
        ["Floors and circulation areas", "Clean floors and circulation areas according to the finish type, suitable products and site conditions."],
        ["Sanitary facilities and accessible glass", "Treat areas included in the proposal, respecting the material, safety conditions and agreed access limits."]
      ],
      requestTitle: "What to include in the request",
      requestLead: "A clear description helps prepare a quotation suited to the premises and required work.",
      request: [
        ["Size and type of premises", "Approximate area, number of rooms, facility type and location."],
        ["Post-work condition", "Visible dust and waste, including paint, cement or other materials requiring specific treatment."],
        ["Access and timing", "Preferred date, water and electricity availability, building access and any working-hour restrictions."]
      ],
      ctaTitle: "Prepare a post-construction cleaning request.",
      ctaText: "Share the location, photographs of the premises and approximate area. Quotation and availability are confirmed after assessment; a request does not constitute an award.",
      cta: "Prepare a cleaning request"
    }
  },
  "ppe-workwear": {
    pt: {
      parent: "Supply e Procurement", parentHref: "/supply/", area: "supply",
      eyebrow: "HMATIAS · SUPPLY & PROCUREMENT",
      title: "Fornecimento de EPI e fardamento para empresas.",
      description: "A HMATIAS recebe pedidos empresariais de equipamentos de protecção individual e fardamento, com análise das especificações, quantidades, condições de entrega e prazo pretendido antes da apresentação de proposta.",
      conditionTitle: "Fornecimento sujeito a confirmação",
      condition: "Marca, modelo, normas exigidas, tamanhos, disponibilidade, transporte e prazo são verificados para cada pedido. A solicitação não confirma stock nem preço.",
      scopeTitle: "O que deve constar do pedido",
      scopeLead: "Uma especificação clara reduz ambiguidades na cotação e na comparação de alternativas.",
      scope: [
        ["Equipamento de protecção individual", "Indique o tipo de equipamento, aplicação, marca ou referência, norma exigida e características técnicas relevantes."],
        ["Fardamento profissional", "Identifique o tipo de vestuário, composição ou material, tamanhos, cores e requisitos de personalização, quando aplicável."],
        ["Quantidades e entrega", "Indique quantidades por referência ou tamanho, local de entrega e prazo pretendido."]
      ],
      requestTitle: "Como é preparada a cotação",
      requestLead: "A proposta é preparada com base na informação disponível e nas confirmações obtidas para o pedido.",
      request: [
        ["Especificação", "São verificados os requisitos técnicos, tamanhos e quantidades indicadas."],
        ["Verificação comercial", "Preço, disponibilidade, transporte e prazo são confirmados antes da proposta final."],
        ["Proposta e fornecimento", "A compra e a entrega avançam apenas após aprovação das condições acordadas."]
      ],
      ctaTitle: "Solicite uma cotação de EPI ou fardamento.",
      ctaText: "Envie a lista de artigos, especificações, quantidades e local de entrega. A HMATIAS analisará o pedido e confirmará as condições antes de assumir qualquer compromisso.",
      cta: "Preparar pedido de fornecimento"
    },
    en: {
      parent: "Supply and Procurement", parentHref: "/en/supply/", area: "supply",
      eyebrow: "HMATIAS · SUPPLY & PROCUREMENT",
      title: "PPE and workwear supply for businesses.",
      description: "HMATIAS receives business requests for personal protective equipment and workwear. Specifications, quantities, delivery conditions and requested timing are reviewed before a proposal is presented.",
      conditionTitle: "Supply subject to confirmation",
      condition: "Brand, model, required standards, sizes, availability, transport and timing are checked for each request. A request does not confirm stock or price.",
      scopeTitle: "What to include in the request",
      scopeLead: "A clear specification reduces ambiguity in quotation and comparison of alternatives.",
      scope: [
        ["Personal protective equipment", "Specify the equipment type, application, brand or reference, required standard and relevant technical characteristics."],
        ["Professional workwear", "Identify garment type, composition or material, sizes, colours and personalisation requirements where applicable."],
        ["Quantities and delivery", "Provide quantities by reference or size, delivery location and requested timing."]
      ],
      requestTitle: "How the quotation is prepared",
      requestLead: "The proposal is prepared using the available information and confirmations obtained for the request.",
      request: [
        ["Specification", "Technical requirements, sizes and quantities are checked."],
        ["Commercial verification", "Price, availability, transport and timing are confirmed before the final proposal."],
        ["Proposal and supply", "Purchasing and delivery proceed only after the agreed conditions are approved."]
      ],
      ctaTitle: "Request a PPE or workwear quotation.",
      ctaText: "Send the item list, specifications, quantities and delivery location. HMATIAS will review the request and confirm conditions before making a commitment.",
      cta: "Prepare a supply request"
    }
  },
  "office-remodelling": {
    pt: {
      parent: "Construção e Remodelação", parentHref: "/construcao/", area: "construction",
      eyebrow: "HMATIAS · CONSTRUÇÃO CIVIL",
      title: "Remodelação de escritórios e espaços comerciais.",
      description: "A HMATIAS recebe pedidos para remodelação e melhoria de espaços de trabalho, com definição do âmbito após levantamento das condições existentes, necessidades do cliente e requisitos de execução.",
      conditionTitle: "Proposta após levantamento",
      condition: "Intervenções, materiais, acabamentos, acessos, segurança, mobilização e prazo são analisados antes da proposta. Não são assumidos custos ou prazos sem validação.",
      scopeTitle: "Áreas a considerar na avaliação",
      scopeLead: "A solução depende do estado do espaço, do objectivo da intervenção e das condições do imóvel.",
      scope: [
        ["Organização e compartimentação", "Avaliação da organização funcional do espaço e de possíveis alterações à compartimentação, conforme as condições existentes."],
        ["Acabamentos e reparações", "Identificação de trabalhos de reparação e acabamentos necessários, de acordo com o estado do imóvel e o resultado pretendido."],
        ["Coordenação da intervenção", "Definição das actividades, sequência de execução, acessos e condições de operação do espaço durante os trabalhos."]
      ],
      requestTitle: "Informação útil para o orçamento",
      requestLead: "O pedido inicial deve permitir compreender o espaço e a intervenção pretendida, sem substituir a visita ou o levantamento técnico.",
      request: [
        ["Localização e área", "Província, município, tipo de imóvel e área aproximada."],
        ["Estado e objectivo", "Descreva as condições actuais, o resultado pretendido e inclua fotografias disponíveis."],
        ["Prazo e operação", "Indique o prazo desejado, horários de acesso e se o espaço continuará em funcionamento durante os trabalhos."]
      ],
      ctaTitle: "Solicite uma avaliação para remodelação.",
      ctaText: "Partilhe a localização, a área aproximada, as intervenções pretendidas e o prazo. A HMATIAS analisará os dados para definir os próximos passos e preparar uma proposta adequada.",
      cta: "Preparar pedido de remodelação"
    },
    en: {
      parent: "Construction and Remodelling", parentHref: "/en/construction/", area: "construction",
      eyebrow: "HMATIAS · CIVIL CONSTRUCTION",
      title: "Office and commercial premises remodelling.",
      description: "HMATIAS receives requests to remodel and improve workplaces. Scope is defined after reviewing existing conditions, client needs and execution requirements.",
      conditionTitle: "Proposal after site assessment",
      condition: "Interventions, materials, finishes, access, safety, mobilisation and timing are reviewed before a proposal. Costs or schedules are not assumed without validation.",
      scopeTitle: "Areas considered during assessment",
      scopeLead: "The solution depends on the condition of the premises, intended outcome and property constraints.",
      scope: [
        ["Layout and partitioning", "Review the functional layout and possible partition changes according to existing conditions."],
        ["Finishes and repairs", "Identify repair and finishing work required based on the property's condition and intended outcome."],
        ["Intervention coordination", "Define activities, execution sequence, access and operating conditions while work is under way."]
      ],
      requestTitle: "Information useful for a quotation",
      requestLead: "The initial request should help describe the premises and intended intervention; it does not replace a site visit or technical survey.",
      request: [
        ["Location and area", "Province, municipality, property type and approximate area."],
        ["Condition and objective", "Describe current conditions, intended outcome and attach available photographs."],
        ["Timing and operations", "Provide the preferred schedule, access hours and whether the premises will remain operational during the work."]
      ],
      ctaTitle: "Request an assessment for remodelling.",
      ctaText: "Share the location, approximate area, requested interventions and timing. HMATIAS will review the information to define next steps and prepare a suitable proposal.",
      cta: "Prepare a remodelling request"
    }
  }
} as const;

const item = content[service][en ? "en" : "pt"];
const smartRfq = en ? "/en/source-ao/smart-rfq/" : "/source-ao/smart-rfq/";
const whatsappText = en
  ? "Hello HMATIAS. I would like to prepare a request for: " + item.title + " Location, scope, quantities or dimensions, access conditions and preferred timing:"
  : "Olá HMATIAS. Pretendo preparar um pedido para: " + item.title + " Localização, âmbito, quantidades ou dimensões, condições de acesso e prazo pretendido:";
const whatsappUrl = "https://wa.me/244948806673?text=" + encodeURIComponent(whatsappText);
const rfqUrl = smartRfq + "?service=" + item.area + "&project=" + encodeURIComponent(item.title);
const title = item.title + " | HMATIAS";
---
<BaseLayout title={title} description={item.description} lang={lang}>
  <div class="preview-bar"><span><i aria-hidden="true"></i> HMATIAS · {en ? "SPECIALIST SERVICE" : "SERVIÇO ESPECIALIZADO"}</span><span>{item.eyebrow}</span></div>
  <SiteHeader />
  <main class="specialist-page">
    <section class="specialist-hero" aria-labelledby="specialist-heading">
      <div class="specialist-hero-grid">
        <div class="specialist-copy">
          <nav aria-label={en ? "Breadcrumb" : "Navegação estrutural"} class="specialist-breadcrumb">
            <a href={en ? "/en/" : "/"}>{en ? "Home" : "Início"}</a><span aria-hidden="true">/</span>
            <a href={item.parentHref}>{item.parent}</a><span aria-hidden="true">/</span>
            <span>{en ? "Specialist service" : "Serviço especializado"}</span>
          </nav>
          <p class="eyebrow"><span class="eyebrow-line"></span>{item.eyebrow}</p>
          <h1 id="specialist-heading">{item.title}</h1>
          <p class="specialist-lead">{item.description}</p>
          <div class="specialist-actions">
            <a class="button button-light" href={rfqUrl}>{item.cta} <span aria-hidden="true">↗</span></a>
            <a class="specialist-whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer">{en ? "Contact HMATIAS on WhatsApp" : "Contactar a HMATIAS pelo WhatsApp"} ↗</a>
          </div>
          <div class="specialist-meta"><span>{en ? "Angola · Assessment before proposal" : "Angola · Avaliação antes da proposta"}</span><span>{en ? "Availability and conditions confirmed individually" : "Disponibilidade e condições confirmadas individualmente"}</span></div>
        </div>
        <aside class="specialist-condition">
          <span>{en ? "SERVICE CONDITIONS" : "CONDIÇÕES DO SERVIÇO"}</span>
          <h2>{item.conditionTitle}</h2>
          <p>{item.condition}</p>
          <small>HMATIAS · {en ? "ANGOLA" : "ANGOLA"}</small>
        </aside>
      </div>
    </section>
    <section class="specialist-section" aria-labelledby="specialist-scope-heading">
      <div class="specialist-heading">
        <p class="section-kicker">01 / {en ? "SCOPE" : "ÂMBITO"}</p>
        <h2 id="specialist-scope-heading">{item.scopeTitle}</h2>
        <p>{item.scopeLead}</p>
      </div>
      <div class="specialist-grid">
        {item.scope.map((entry, index) => <article class="specialist-card"><span>{String(index + 1).padStart(2, "0")}</span><h3>{entry[0]}</h3><p>{entry[1]}</p></article>)}
      </div>
    </section>
    <section class="specialist-section specialist-section-muted" aria-labelledby="specialist-request-heading">
      <div class="specialist-heading">
        <p class="section-kicker">02 / {en ? "REQUEST PREPARATION" : "PREPARAÇÃO DO PEDIDO"}</p>
        <h2 id="specialist-request-heading">{item.requestTitle}</h2>
        <p>{item.requestLead}</p>
      </div>
      <div class="specialist-grid">
        {item.request.map((entry, index) => <article class="specialist-card specialist-card-plain"><span>{String(index + 1).padStart(2, "0")}</span><h3>{entry[0]}</h3><p>{entry[1]}</p></article>)}
      </div>
    </section>
    <section class="specialist-cta">
      <div><p class="section-kicker">03 / {en ? "NEXT STEP" : "PRÓXIMO PASSO"}</p><h2>{item.ctaTitle}</h2><p>{item.ctaText}</p></div>
      <div class="specialist-cta-actions">
        <a class="button button-dark" href={rfqUrl}>{en ? "Prepare request" : "Preparar pedido"} ↗</a>
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">{en ? "WhatsApp" : "WhatsApp"} ↗</a>
      </div>
    </section>
  </main>
  <SiteFooter />
  <div class="preview-disclaimer">{en ? "Independent technology preview. The request brief is prepared in the browser and is not an automatic quotation or order." : "Pré-visualização tecnológica independente. O pedido é preparado no navegador e não constitui cotação ou encomenda automática."}</div>
  <style>
    .specialist-page{background:var(--hm-paper);color:var(--hm-ink)}
    .specialist-hero{padding:clamp(54px,7vw,90px) var(--hm-gutter);background:var(--hm-navy);color:#fff}
    .specialist-hero-grid{max-width:1320px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1.35fr) minmax(270px,.65fr);gap:clamp(30px,6vw,82px);align-items:center}
    .specialist-breadcrumb{display:flex;flex-wrap:wrap;gap:9px;margin-bottom:28px;color:#dce8f3;font-size:10px}
    .specialist-breadcrumb a{color:#dce8f3;text-decoration:underline;text-underline-offset:3px}
    .specialist-copy .eyebrow{color:var(--hm-sky);margin:0 0 20px}
    .specialist-copy h1{max-width:820px;margin:0;font-size:clamp(39px,5.7vw,72px);line-height:1.04;font-weight:520;letter-spacing:-.06em}
    .specialist-lead{max-width:720px;margin:22px 0 0;color:#e1edf7;font-size:13px;line-height:1.85}
    .specialist-actions{display:flex;align-items:center;flex-wrap:wrap;gap:20px;margin-top:28px}
    .specialist-actions .button{color:var(--hm-navy);background:#fff}
    .specialist-whatsapp{color:#fff;font-size:11px;text-decoration:underline;text-underline-offset:4px}
    .specialist-meta{display:flex;flex-wrap:wrap;gap:9px 20px;margin-top:32px;color:#c5dced;font-size:9px;letter-spacing:.04em}
    .specialist-condition{padding:28px;background:var(--hm-paper);color:var(--hm-ink);border-left:3px solid var(--hm-sky)}
    .specialist-condition>span{display:block;margin-bottom:16px;color:var(--hm-blue);font-family:var(--hm-mono);font-size:9px;font-weight:700;letter-spacing:.14em}
    .specialist-condition h2{margin:0;font-size:22px;line-height:1.35;font-weight:650}
    .specialist-condition p{margin:14px 0 22px;color:var(--hm-muted);font-size:11px;line-height:1.8}
    .specialist-condition small{display:block;padding-top:14px;border-top:1px solid var(--hm-line);color:var(--hm-blue);font-size:9px;font-weight:700;letter-spacing:.1em}
    .specialist-section{padding:clamp(45px,6vw,76px) var(--hm-gutter);background:var(--hm-paper)}
    .specialist-section-muted{background:#f0f4f7}
    .specialist-heading{max-width:850px;margin-bottom:28px}
    .specialist-heading .section-kicker{margin:0 0 12px}
    .specialist-heading h2{margin:0;font-size:clamp(28px,4vw,44px);font-weight:530;letter-spacing:-.045em}
    .specialist-heading>p:last-child{max-width:650px;margin:12px 0 0;color:var(--hm-muted);font-size:12px;line-height:1.8}
    .specialist-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px}
    .specialist-card{min-width:0;padding:22px;background:#fff;border:1px solid var(--hm-line)}
    .specialist-card>span{display:block;color:var(--hm-blue);font-family:var(--hm-mono);font-size:10px;font-weight:700}
    .specialist-card h3{margin:18px 0 9px;font-size:17px;line-height:1.35;font-weight:650}
    .specialist-card p{margin:0;color:var(--hm-muted);font-size:11px;line-height:1.8}
    .specialist-card-plain{background:#f7f9fb}
    .specialist-cta{padding:clamp(35px,5vw,58px) var(--hm-gutter);display:flex;justify-content:space-between;align-items:center;gap:30px;background:#fff;border-top:1px solid var(--hm-line)}
    .specialist-cta>div:first-child{max-width:760px}
    .specialist-cta .section-kicker{margin:0 0 12px}
    .specialist-cta h2{margin:0;font-size:clamp(26px,3.5vw,40px);font-weight:540;letter-spacing:-.045em}
