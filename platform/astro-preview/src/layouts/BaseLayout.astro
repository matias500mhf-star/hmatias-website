---
import "../styles/global.css";
import favicon from "../../../../images/favicon.png";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---
<!doctype html>
<html lang="pt-AO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#062d56" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HMATIAS" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pt_AO" />
    <meta property="og:image" content="https://comercialhmatiasps.com/og-hmatias.jpg" />
    <meta property="og:image:alt" content="HMATIAS — Prestação de Serviços" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://comercialhmatiasps.com/og-hmatias.jpg" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href={favicon.src} />
  </head>
  <body>
    <slot />
  </body>
</html>